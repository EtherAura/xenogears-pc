; The xenogears-pc setup for 64-bit Windows.
;
; A template: packaging/windows_release.py render fills each placeholder (a
; name between at signs) from the release tag and the installed stage (cmake --install of port/), then makensis
; builds the setup in the rendered script's folder. A rendered script has no
; placeholder left; the renderer refuses one that would.
;
; Where things go: the files of the stage into Program Files, read-only for
; the game. Everything the port writes (settings.ini, memory cards, save
; backups, records, logs) is in the player's own folder, %APPDATA%\xenogears
; (SDL_GetPrefPath), which neither this setup nor its uninstaller touches.
; The uninstaller deletes the files this setup installed, by name, and then
; each folder only if it is empty (RMDir without /r): anything else the player
; put there, such as a disc image beside the executable, stays.
; No file of the game is in the setup: the port reads the player's own disc.
;
; An update from the game (port/src/update/update_install.c, xg-4oq.14.4) runs
; this setup as "/S /UPDATE=<executable> /D=<the installed folder>": silently,
; over the installed copy. It first waits, up to a minute, until the game has
; quit (its executable can be opened for writing), and when done starts that
; executable again as the player, not elevated: through Explorer. Only the
; two executables' names are taken.

Unicode true
ManifestDPIAware true
SetCompressor /SOLID lzma
RequestExecutionLevel admin

!include "MUI2.nsh"
!include "LogicLib.nsh"
!include "x64.nsh"
!include "FileFunc.nsh"

!define PRODUCT "Xenogears PC"
!define UNINSTALL_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\xenogears-pc"

Var UpdateExe ; the game's executable, when the game runs this setup to update itself

Name "${PRODUCT} @VERSION@"
OutFile "@SETUP_NAME@"
InstallDir "$PROGRAMFILES64\${PRODUCT}"

VIProductVersion "@NSIS_VERSION@"
VIFileVersion "@NSIS_VERSION@"
VIAddVersionKey "ProductName" "${PRODUCT}"
VIAddVersionKey "ProductVersion" "@VERSION@"
VIAddVersionKey "FileVersion" "@VERSION@"
VIAddVersionKey "FileDescription" "${PRODUCT} @VERSION@ setup"
VIAddVersionKey "LegalCopyright" "GNU GPL v3 or later (COPYING.txt)"

!define MUI_ABORTWARNING
!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_LICENSE "@LICENSE_FILE@"
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "English"

Function .onInit
  ${IfNot} ${RunningX64}
    MessageBox MB_ICONSTOP "${PRODUCT} needs 64-bit Windows." /SD IDOK
    Abort
  ${EndIf}
  SetRegView 64
  SetShellVarContext all
  ${GetParameters} $R0
  ClearErrors
  ${GetOptions} $R0 "/UPDATE=" $UpdateExe
  ${If} ${Errors}
  ${OrIf} $UpdateExe != "xenogears.exe"
  ${AndIf} $UpdateExe != "xenogears-enhanced.exe"
    StrCpy $UpdateExe ""
  ${EndIf}
  ; A copy installed before: its folder, from the key the Install section writes in the
  ; 64-bit view (InstallDirRegKey would read the 32-bit one: this setup is a 32-bit program).
  ; A folder given with /D= (an update always gives one) is kept: only then does $INSTDIR
  ; differ from InstallDir here.
  ${If} $UpdateExe == ""
  ${AndIf} $INSTDIR == "$PROGRAMFILES64\${PRODUCT}"
    ClearErrors
    ReadRegStr $R1 HKLM "${UNINSTALL_KEY}" "InstallLocation"
    ${IfNot} ${Errors}
    ${AndIf} $R1 != ""
      StrCpy $INSTDIR $R1
    ${EndIf}
  ${EndIf}
FunctionEnd

; An update: the game has quit when its executable can be opened for writing (a running
; executable cannot); a minute at most.
Function WaitForTheGame
  StrCpy $R1 0
  ${DoWhile} $R1 < 240
    ${IfNot} ${FileExists} "$INSTDIR\$UpdateExe"
      Return
    ${EndIf}
    ClearErrors
    FileOpen $R2 "$INSTDIR\$UpdateExe" a
    ${IfNot} ${Errors}
      FileClose $R2
      Return
    ${EndIf}
    Sleep 250
    IntOp $R1 $R1 + 1
  ${Loop}
FunctionEnd

Function un.onInit
  SetRegView 64
  SetShellVarContext all
FunctionEnd

Section "Install"
  ${If} $UpdateExe != ""
    Call WaitForTheGame
  ${EndIf}
@INSTALL_FILES@
  SetOutPath "$INSTDIR"
  ; What the in-app updater reads (port/src/system/release.h): this release, installed by its setup.
  FileOpen $0 "$INSTDIR\release.txt" w
  FileWrite $0 "version=@VERSION@$\nkind=setup$\n"
  FileClose $0
  WriteUninstaller "$INSTDIR\uninstall.exe"

  CreateDirectory "$SMPROGRAMS\${PRODUCT}"
@SHORTCUTS@
  CreateShortcut "$SMPROGRAMS\${PRODUCT}\Uninstall ${PRODUCT}.lnk" "$INSTDIR\uninstall.exe"

  WriteRegStr HKLM "${UNINSTALL_KEY}" "DisplayName" "${PRODUCT}"
  WriteRegStr HKLM "${UNINSTALL_KEY}" "DisplayVersion" "@VERSION@"
  WriteRegStr HKLM "${UNINSTALL_KEY}" "Publisher" "xenogears-pc contributors"
  WriteRegStr HKLM "${UNINSTALL_KEY}" "DisplayIcon" "$INSTDIR\xenogears.exe"
  WriteRegStr HKLM "${UNINSTALL_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegStr HKLM "${UNINSTALL_KEY}" "UninstallString" "$\"$INSTDIR\uninstall.exe$\""
  WriteRegStr HKLM "${UNINSTALL_KEY}" "QuietUninstallString" "$\"$INSTDIR\uninstall.exe$\" /S"
  WriteRegDWORD HKLM "${UNINSTALL_KEY}" "EstimatedSize" @ESTIMATED_SIZE_KB@
  WriteRegDWORD HKLM "${UNINSTALL_KEY}" "NoModify" 1
  WriteRegDWORD HKLM "${UNINSTALL_KEY}" "NoRepair" 1

  ; An update: the game again, as the player (Explorer starts it; this setup runs elevated).
  ${If} $UpdateExe != ""
    Exec '"$WINDIR\explorer.exe" "$INSTDIR\$UpdateExe"'
  ${EndIf}
SectionEnd

Section "Uninstall"
@UNINSTALL_FILES@
  Delete "$INSTDIR\release.txt"
  Delete "$INSTDIR\uninstall.exe"
@UNINSTALL_DIRS@
  RMDir "$INSTDIR"

@UNSHORTCUTS@
  Delete "$SMPROGRAMS\${PRODUCT}\Uninstall ${PRODUCT}.lnk"
  RMDir "$SMPROGRAMS\${PRODUCT}"
  DeleteRegKey HKLM "${UNINSTALL_KEY}"
SectionEnd
