msgstr " 兩張碟片"

#: port/src/ui/sections.cpp
#, c-format
msgid ""
"No %s Xenogears image in %s or the folders in it (only another release's)."
msgstr "%s Xenogears的影像在%s或其中的資料夾中(只有另一版的)."

#: port/src/ui/sections.cpp
#, c-format
