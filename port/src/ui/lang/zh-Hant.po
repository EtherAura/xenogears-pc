#, c-format
msgid "Kanji glyphs from %s"
msgstr "%s的坎吉格言"

#: port/src/ui/sections.cpp
#, c-format
msgid "%s is not a 512 KB PS1 BIOS image"
msgstr "%s不是512 KB PS1 BIOS 影像"

#: port/src/ui/sections.cpp
#, c-format
