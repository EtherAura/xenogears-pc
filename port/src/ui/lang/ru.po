#, c-format
msgid "%s cannot be opened"
msgstr "%s не открывается"

#: port/src/ui/sections.cpp
msgid "The system has no file picker"
msgstr "Система не имеет файлового фильтра"

#: port/src/ui/sections.cpp
msgid "Choose a BIOS file"
msgstr "Выберите файл BIOS"

#: port/src/ui/sections.cpp
msgid "Use the disc folder's"
msgstr "Используйте папку диска"

#: port/src/ui/sections.cpp
msgid "No BIOS: the kanji glyphs are blank"
msgstr "Нет BIOS: глифы кандзи пустые"

