msgstr "Ни один Гир не назначен"

#: port/src/ui/arena.cpp
#, c-format
msgid "Assign a Gear to %s."
msgstr "Назначьте Gear для %s."

#: port/src/ui/arena.cpp port/src/ui/sections.cpp
