#, c-format
msgid "The host's party could not be used here: %s"
msgstr "La festa dell'ospite non può essere utilizzata qui: %s"

#: port/src/ui/arena.cpp
#, c-format
msgid "Your party could not be used: %s"
msgstr "La tua festa non potrebbe essere utilizzata: %s"

#: port/src/ui/arena.cpp
#, c-format
msgid "The two games went apart at vblank %s, so the session stopped."
msgstr ""
"I due giochi sono andati a parte a vblank %s, così la sessione si è fermata."

#: port/src/ui/arena.cpp
#, c-format
msgid "The session's window closed (exit code %s)."
msgstr "Finestra della sessione chiusa (codice di uscita %s )."

#: port/src/ui/arena.cpp
#, c-format
msgid "The session could not start: %s"
msgstr "La sessione non poteva iniziare: %s"

#: port/src/ui/arena.cpp
msgid "Close lobby"
msgstr "Vicino alla hall"

#: port/src/ui/arena.cpp
msgid "Propose loadout"
msgstr "Proporre il carico"

#: port/src/ui/arena.cpp
msgid "Loadout confirmed"
msgstr "Caricamento confermato"

#: port/src/ui/arena.cpp
msgid "The lobby could not start."
msgstr "La lobby non poteva cominciare."

#: port/src/ui/arena.cpp
msgid "Online match in progress."
msgstr "Gioco online in corso."

#: port/src/ui/arena.cpp
msgid ""
"At the end of a match, choose Rematch or Leave. EXIT in Battling closes the "
"session."
msgstr ""
"Alla fine di una partita, scegli Rematch o Leave. EXIT in Battling chiude "
"la sessione."

#: port/src/ui/arena.cpp
#, c-format
msgid ""
"Waiting for player 2 on UDP port %s. They join with your address, this port "
"and the code."
msgstr ""
"In attesa del giocatore 2 sulla porta UDP %s. Si uniscono con il vostro "
"indirizzo, questa porta e il codice."

#: port/src/ui/arena.cpp
#, c-format
msgid "Joining %s..."
msgstr "Unisciti a %s ..."

#: port/src/ui/arena.cpp
msgid "Starting the match. Waiting for both games to finish loading."
msgstr "In attesa che entrambi i giochi finiscano il caricamento."

#: port/src/ui/arena.cpp
#, c-format
msgid ""
"Playing with %s (input delay %d). They see your address, as you see theirs."
msgstr ""
"Giocando con %s (ritardo di ingresso %d ), vedono il tuo indirizzo, come "
"vedi il loro."

#: port/src/ui/arena.cpp
msgid "Starting the session..."
msgstr "Avviare la sessione..."

#: port/src/ui/arena.cpp
msgid ""
"The joining player approved a different loadout. Waiting for a match."
msgstr ""
"Il giocatore di unione ha approvato un carico diverso. In attesa di una "
"partita."

#: port/src/ui/arena.cpp
#, c-format
msgid ""
"A player joined with a party that cannot be used, and was refused (they see "
"why): %s Waiting for another."
msgstr ""
"Un giocatore si unì a un partito che non può essere utilizzato, e fu "
"rifiutato (si vede perché): %s Attendendo un altro."

#: port/src/ui/arena.cpp
msgid "The other player paused."
msgstr "L'altro giocatore si fermò."

#: port/src/ui/arena.cpp
msgid ""
"The connection is lost: the session waits for it to come back (up to a "
"minute), then goes on where it stopped."
msgstr ""
"La connessione è persa: la sessione aspetta che torni (fino a un minuto), "
"poi prosegue dove si è fermato."

#: port/src/ui/arena.cpp
msgid "End the session"
msgstr "Fine della sessione"

#: port/src/ui/arena.cpp
msgid "End the match for both players and return to the paused game."
msgstr ""
"Terminare la partita per entrambi i giocatori e tornare al gioco in pausa."

