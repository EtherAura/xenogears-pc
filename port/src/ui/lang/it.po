msgid "The host plays the other region's game (US/JP)."
msgstr "L'ospite gioca il gioco dell'altra regione (US/JP)."

#: port/src/ui/arena.cpp
msgid "The host is busy."
msgstr "L'ospite e' occupato."

#: port/src/ui/arena.cpp
msgid ""
"Select Versus battle and choose an enemy formation, then join again."
msgstr ""
"Selezionare la battaglia di Versus e scegliere una formazione nemico, "
"quindi unirsi di nuovo."

#: port/src/ui/arena.cpp
msgid ""
"The host is playing a different match type. Ask them to host Gear Battling."
msgstr ""
"L'ospite sta giocando un altro tipo di partita. Chiedi loro di ospitare "
"Gear Battling."

#: port/src/ui/arena.cpp
msgid "The other player's disc is not the same as yours."
msgstr "Il disco dell'altro giocatore non è lo stesso del tuo."

#: port/src/ui/arena.cpp
msgid "Both players need to approve the same valid custom loadout."
msgstr ""
"Entrambi i giocatori devono approvare lo stesso carico personalizzato "
"valido."

#: port/src/ui/arena.cpp
msgid "Select Party vs party and choose a save, then join again."
msgstr ""
"Selezionare Partito vs partito e scegliere un salvataggio, quindi unirsi di "
"nuovo."

