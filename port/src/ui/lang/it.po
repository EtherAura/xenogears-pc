#, c-format
msgid "The last session: %s"
msgstr "L'ultima sessione: %s"

#: port/src/ui/arena.cpp
msgid "Connection"
msgstr "Connessione"

#: port/src/ui/arena.cpp
msgid "Host (player 1)"
msgstr "Host (player 1)"

#: port/src/ui/arena.cpp
msgid "Join (player 2)"
msgstr "Unisciti (player 2)"

#: port/src/ui/arena.cpp
msgid "Use the same game version, disc and session code."
msgstr "Utilizzare la stessa versione di gioco, disco e codice di sessione."

#: port/src/ui/arena.cpp
msgid "After connecting, choose BONUS BATTLING, then PLAYER1 VS PLAYER2."
msgstr ""
"Dopo la connessione, scegliere BONUS BATTLING, quindi PLAYER1 VS PLAYER2."

#: port/src/ui/arena.cpp
msgid "Session code"
msgstr "Codice di sessione"

#: port/src/ui/arena.cpp
msgid ""
"The same word for both players. It keeps others out of the session; it does "
"not encrypt it."
msgstr ""
"La stessa parola per entrambi i giocatori. Mantiene gli altri fuori dalla "
"sessione; non la crittografa."

#: port/src/ui/arena.cpp
msgid "UDP port"
msgstr "Porta UDP"

#: port/src/ui/arena.cpp
msgid ""
"Use a reachable UDP port. Play on the same network, over a VPN, or forward "
"the port on the host's router."
msgstr ""
"Usa una porta UDP raggiungibile. Gioca sulla stessa rete, su una VPN o "
"inoltra la porta sul router dell'host."

#: port/src/ui/arena.cpp
msgid "Input delay"
msgstr "Ritardo dell'ingresso"

#: port/src/ui/arena.cpp
msgid ""
"Vblanks between a press and what it does, the same on both screens: 2 on a "
"home network, 3 to 6 over the internet."
msgstr ""
"Vblanks tra una stampa e quello che fa, lo stesso su entrambi gli schermi: "
"2 su una rete domestica, 3 a 6 su Internet."

#: port/src/ui/arena.cpp
msgid "The host's address:port"
msgstr "L'indirizzo dell'host:port"

#: port/src/ui/arena.cpp
msgid ""
"A name or an IPv4 address, then the port (192.168.1.20:7461); an IPv6 "
"address goes in brackets ([2001:db8::20]:7461)."
msgstr ""
"Un nome o un indirizzo IPv4, poi la porta (192.168.1.20:7461); un indirizzo "
"IPv6 passa tra parentesi ([2001:db8::20]:7461)."

#: port/src/ui/arena.cpp
msgid "Player 2 chooses the formation"
