msgid "The address is not host:port, or that host is unknown."
msgstr "L'indirizzo non è host:port, o quell'host è sconosciuto."

#: port/src/ui/arena.cpp
msgid "The network could not be used (is the port in use?)."
msgstr "La rete non può essere utilizzata (è la porta in uso?)."

