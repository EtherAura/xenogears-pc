msgid "Enhanced (Hard Mode, Undub)"
msgstr "Mejorado (Modo de riesgo, Indub)"

#: port/src/ui/options.cpp
msgid ""
"Enhanced (Hard Mode) with Japanese battle voices, Japanese cutscene audio "
"and Japanese-translation subtitles."
msgstr ""
"Mejorado (modo de riesgo) con voces de batalla japonesas, audio de corte "
"japonés y subtítulos de traducción japonesa."

#: port/src/ui/options.cpp
msgid "Crisp Widescreen"
msgstr "Crisp Pantalla ancha"

#: port/src/ui/options.cpp
msgid ""
"Clean modern presentation without post-processing: the Enhanced engine, "
"16:9 widescreen with expanded vertical framing, Auto resolution, Nearest "
"filter, 60 Hz modes, Speedup, and all HD-2D scene effects off."
msgstr ""
"Presentación moderna limpia sin post-procesamiento: el motor mejorado, 16:9 "
"pantalla ancha con encuadre vertical ampliado, resolución automática, "
"filtro más cercano, 60 modos Hz, Speedup y todos los efectos de escena "
"HD-2D."

#: port/src/ui/options.cpp
