msgid "Since chosen: %d texts from it, %d kept the disc's."
msgstr "Desde su elección: textos %d de él, %d mantuvo el disco."

#: port/src/ui/gametext.cpp
msgid "The pack prints its text with proportional glyphs."
msgstr "El paquete imprime su texto con glifos proporcionales."

