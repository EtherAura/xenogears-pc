msgid "This source has no separate movie subtitle track."
msgstr "Esta fuente no tiene un subtítulo de película separado."

#: port/src/ui/gametext.cpp
msgid ""
"Movie subtitles use the English translation of the Japanese dialogue."
msgstr ""
"Los subtítulos de la película usan la traducción al inglés del diálogo "
"japonés."

