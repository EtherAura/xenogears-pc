msgstr "retour à la liste des sections"

#: port/src/ui/sections.cpp
msgid "the previous and next section"
msgstr "la section précédente et la section suivante"

#: port/src/ui/sections.cpp
msgid "Square / Delete"
msgstr "Carré / Supprimer"

#: port/src/ui/sections.cpp
msgid "reset the setting the cursor is on (gold: changed)"
msgstr "réinitialisez le réglage du curseur (or : modifié)"

#: port/src/ui/sections.cpp
msgid "search the settings"
msgstr "rechercher les paramètres"

#: port/src/ui/sections.cpp
