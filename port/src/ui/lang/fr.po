#: port/src/ui/sections.cpp port/src/ui/states.cpp
msgid "No"
msgstr "Non"

#: port/src/ui/sections.cpp port/src/ui/states.cpp
msgid "Yes"
msgstr "Oui"

#: port/src/ui/sections.cpp
msgid ""
"Yes: play without one, and do not ask again (later launches start right "
"away)."
msgstr ""
"Oui: jouer sans un, et ne pas demander à nouveau (plus tard les lancements "
"commencent tout de suite)."

#: port/src/ui/sections.cpp
msgid ""
"No BIOS image is set. Everything works without one but the save titles on "
"the memory card screens and the text that scrolls over some scenes, which "
"stay blank. A BIOS can be set later in the settings menu (F1, System)."
msgstr ""
"Aucune image BIOS n'est définie. Tout fonctionne sans un, mais les titres "
"de sauvegarde sur les écrans de carte mémoire et le texte qui défile sur "
"certaines scènes, qui restent vides. Un BIOS peut être défini plus tard "
"dans le menu paramètres (F1, System)."

#: port/src/ui/sections.cpp
msgid "Play without a BIOS"
msgstr "Jouer sans BIOS"

#: port/src/ui/sections.cpp
msgid "Choose a BIOS"
msgstr "Choisir un BIOS"

#: port/src/ui/sections.cpp
msgid "Memory cards become available once a disc image is selected."
msgstr ""
"Les cartes mémoire deviennent disponibles une fois qu'une image disque est "
"sélectionnée."

#: port/src/ui/sections.cpp
msgid "Save states become available once the game is running."
msgstr "Enregistrer les états deviennent disponibles une fois le jeu lancé."

#: port/src/ui/sections.cpp
msgid "Extras become available once a disc image is selected."
msgstr ""
"Les extras deviennent disponibles une fois qu'une image disque est "
"sélectionnée."

#: port/src/ui/shaders.cpp
#, c-format
msgid ""
"%d pass%s. RetroArch .slangp presets and .slang shaders (not .glslp or "
".cgp)."
msgstr ""
"%d passe %s. Presets RetroArch .slangp et shaders .slang (pas .glslp ou "
".cgp)."

#: port/src/ui/shaders.cpp
msgid "Movie parameters"
msgstr "Paramètres du film"

#: port/src/ui/shaders.cpp
msgid "Parameters"
msgstr "Paramètres"

#: port/src/ui/shaders.cpp
msgid ""
"This build has no shader compiler (Khronos glslang): presets cannot be used."
msgstr ""
"Cette compilation n'a pas de compilateur de shader (Khronos glslang) : les "
"presets ne peuvent pas être utilisés."

#: port/src/ui/shaders.cpp
msgid ""
"A RetroArch .slangp preset or .slang shader over the picture (CRT, scalers, "
"sharpening). Off: the picture as it is."
msgstr ""
"A RetroArch .slangp preset ou .slang shader sur l'image (CRT, scalers, "
"affûtage). Off: l'image telle qu'elle est."

#: port/src/ui/shaders.cpp
msgid "Movie shader"
msgstr "Shader du film"

#: port/src/ui/shaders.cpp
msgid ""
"The movies (24-bit pictures; a pack's movie pictures too): the picture's "
"shader, none, a preset of their own, or the built-in smoothing (the MDEC's "
"block edges softened, a sharp Catmull-Rom upscale)."
msgstr ""
"Les films (24-bit images; les films d'un pack aussi) : le shader de "
"l'image, aucun, un preset de leur propre, ou le lissage intégré (les bords "
"de bloc du MDEC ramollis, un Catmull-Rom aiguisé upscale)."

#: port/src/ui/skin.cpp
msgid "Hide"
msgstr "Masquer"

#: port/src/ui/states.cpp
#, c-format
msgid "Slot %d"
msgstr "Fente %d"

#: port/src/ui/states.cpp
#, c-format
msgid "Disc %d  %s"
msgstr "Disque %d %s"

#: port/src/ui/states.cpp
#, c-format
msgid "Play time %u:%02u:%02u"
msgstr "Temps de lecture %u : %02u : %02u"

#: port/src/ui/states.cpp
msgid "This version only"
msgstr "Cette version seulement"

#: port/src/ui/states.cpp
#, c-format
msgid "Version %s's"
msgstr "Version %s 's"

#: port/src/ui/states.cpp
msgid "Another build's"
msgstr "Une autre construction"

#: port/src/ui/states.cpp
msgid ""
"Hold R (F10 when R plays a button) or Select+L2 on a gamepad to go back; "
"let go to play on from there."
msgstr ""
"Maintenez R ( F10 quand R joue un bouton) ou Select+L2 sur un gamepad pour "
"revenir en arrière; laissez aller pour jouer à partir de là."

#: port/src/ui/states.cpp
#, c-format
msgid ""
"Kept now: %.1f s in %.0f MB; a capture takes %.1f ms of the game's time (at "
"worst %.1f)."
msgstr ""
"Kept now: %.1f s dans %.0f MB; une capture prend %.1f ms du temps du jeu "
"(au pire %.1f )."

#: port/src/ui/states.cpp
msgid ""
"Off: nothing is kept and the game runs as without it. On, each capture "
"costs a few milliseconds."
msgstr ""
"Off: rien n'est gardé et le jeu fonctionne comme sans. Sur, chaque capture "
"coûte quelques millisecondes."

#: port/src/ui/states.cpp
msgid "The seconds of play rewind keeps (with Rewind on). 30 s by default."
msgstr ""
"Les secondes de jeu rewind se maintiennent (avec Rewind on). 30 s par "
"défaut."

#: port/src/ui/states.cpp
msgid ""
"A capture every N frames: 1 goes back most smoothly, 4 costs least. 2 by "
"default."
msgstr ""
"Une capture de chaque cadre N : 1 remonte très bien, 4 coûte moins. 2 par "
"défaut."

#: port/src/ui/states.cpp
msgid ""
"The memory rewind takes at most: when it is full, the oldest captures go "
"first. 256 MB by default."
msgstr ""
"Le rembobinage de la mémoire prend tout au plus: quand il est plein, les "
"plus anciennes captures passent en premier. 256 Mo par défaut."

#: port/src/ui/states.cpp
msgid ""
"Threads comparing the game's memory at a capture (the game's own thread one "
"of them): more make a capture shorter on a CPU with cores to spare. 4 by "
"default."
msgstr ""
"Les fils comparant la mémoire du jeu à une capture (le propre fil du jeu "
"l'un d'entre eux): plus faire une capture plus courte sur un CPU avec des "
"noyaux à épargner. 4 par défaut."

#: port/src/ui/states.cpp
msgid "Selected slot"
msgstr "Slot sélectionné"

#: port/src/ui/states.cpp
#, c-format
msgid "Save to slot %d"
msgstr "Enregistrer dans la fente %d"

#: port/src/ui/states.cpp
#, c-format
msgid "Load slot %d"
msgstr "Charger la fente %d"

#: port/src/ui/states.cpp
msgid "Undo the last load"
msgstr "Annuler la dernière charge"

#: port/src/ui/states.cpp
msgid ""
"F7 saves to the selected slot, F8 loads it, F9 and Shift+F9 choose the "
"slot, Shift+F8 undoes the last load."
msgstr ""
"F7 enregistre dans la fente sélectionnée, F8 la charge, F9 et Shift+ F9 "
"choisissent la fente, Shift+ F8 désactive la dernière charge."

#: port/src/ui/states.cpp
#, c-format
msgid "Back to the game as it was when a state was last loaded (%s, %s)."
msgstr ""
"Retour au jeu comme c'était quand un état a été chargé pour la dernière "
"fois ( %s, %s )."

#: port/src/ui/states.cpp
#, c-format
msgid "Slot %d cannot be loaded: %s."
msgstr "La fente %d ne peut pas être chargée : %s."

#: port/src/ui/states.cpp
msgid "Delete the state another version made"
msgstr "Supprimer l'état une autre version faite"

#: port/src/ui/states.cpp
#, c-format
msgid "Delete the %d states other versions made"
msgstr "Supprimer le %d indique d'autres versions faites"

#: port/src/ui/states.cpp
msgid ""
"States made before an update of the app cannot be loaded by this version: a "
"state holds the program's own memory, which an update moves. Memory card "
"saves carry over."
msgstr ""
"Les états réalisés avant une mise à jour de l'application ne peuvent pas "
"être chargés par cette version : un état détient la propre mémoire du "
"programme, qu'une mise à jour bouge."

#: port/src/ui/states.cpp
msgid ""
"A save state is the whole game at a moment: loading it goes back there "
"exactly. Loading never changes the memory cards: saves made since stay on "
"them, and the game reads the cards again. Slot saves wait for a point that "
"other compatible versions can resume. Older saves marked \"This version "
"only\" load in the build that saved them. Keep long-term progress on memory "
"cards."
msgstr ""
"Un état de sauvegarde est l'ensemble du jeu à un moment: chargement il "
"revient exactement là. Chargement ne change jamais les cartes mémoire: "
"sauvegardes faites depuis rester sur eux, et le jeu lit les cartes à "
"nouveau. La fente sauve attendre un point que d'autres versions compatibles "
"peuvent reprendre."

#: port/src/ui/states.cpp
msgid ""
"A save state is the whole game at a moment: loading it goes back there "
"exactly. Loading never changes the memory cards: saves made since stay on "
"them, and the game reads the cards again. States load only in the build of "
"the port that saved them: after the port is updated or rebuilt, older "
"states are refused. Keep long-term progress on memory cards."
msgstr ""
"Un état de sauvegarde est l'ensemble du jeu à un moment donné: chargement "
"il y retourne exactement. Chargement ne change jamais les cartes mémoire: "
"sauvegardes faites depuis rester sur elles, et le jeu lit les cartes à "
"nouveau. États chargent seulement dans la construction du port qui les a "
"sauvegardés: après la mise à jour ou la reconstruction du port, les anciens "
"états sont refusés."

#: port/src/ui/states.cpp
#, c-format
msgid "Save over slot %d?"
msgstr "Enregistrer sur la fente %d ?"

#: port/src/ui/states.cpp
msgid ""
"Delete every state other versions of the app made? This version cannot load "
"them."
msgstr ""
"Supprimer chaque état d'autres versions de l'application faite? Cette "
"version ne peut pas les charger."

#: port/src/ui/states.cpp
#, c-format
msgid "Delete the state in slot %d?"
msgstr "Supprimer l'état dans la fente %d ?"

#: port/src/ui/states.cpp
#, c-format
msgid "%d states deleted."
msgstr "%d est supprimé."

#: port/src/ui/states.cpp
#, c-format
msgid "Slot %d deleted."
msgstr "Fente %d supprimée."

#: port/src/ui/updates.cpp
msgid "Ask at the next start"
msgstr "Demandez au prochain départ"

#: port/src/ui/updates.cpp
msgid "Once a day"
msgstr "Une fois par jour"

#: port/src/ui/updates.cpp
msgid "Never"
msgstr "Jamais"

#: port/src/ui/updates.cpp
#, c-format
msgid "%.1f of %.1f MB"
msgstr "%.1f de %.1f MB"

#: port/src/ui/updates.cpp
msgid "Looking at the release..."
msgstr "En regardant la libération..."

#: port/src/ui/updates.cpp
msgid "Checking the download..."
msgstr "Vérification du téléchargement..."

#: port/src/ui/updates.cpp
msgid "Unpacking..."
msgstr "Déballage..."

#: port/src/ui/updates.cpp
msgid "Downloading..."
msgstr "Téléchargement..."

#: port/src/ui/updates.cpp
msgid "Cancel the install"
msgstr "Annuler l'installation"

#: port/src/ui/updates.cpp
msgid ""
"Android installs it (confirm on its screen if it asks) and closes the app: "
"open it again."
msgstr ""
"Android l'installe (confirmer sur son écran s'il le demande) et ferme "
"l'application : l'ouvrir à nouveau."

#: port/src/ui/updates.cpp
msgid "Starting the new version..."
msgstr "Démarrage de la nouvelle version..."

#: port/src/ui/updates.cpp
#, c-format
msgid "The install stopped: %s."
msgstr "L'installation s'est arrêtée : %s."

#: port/src/ui/updates.cpp
#, c-format
msgid "Installing it from here is not possible: %s."
msgstr "L'installer à partir d'ici n'est pas possible : %s."

#: port/src/ui/updates.cpp
msgid "Install and restart"
msgstr "Installer et redémarrer"

#: port/src/ui/updates.cpp
#, c-format
msgid ""
"Install Xenogears PC port %s now? The game downloads its setup and checks "
"it, then closes; Windows asks for permission, and the setup installs it and "
"starts the game again. Progress since your last save is lost; the settings, "
"memory cards and save states are kept."
msgstr ""
"Installez Xenogears port PC %s maintenant? Le jeu télécharge sa "
"configuration et le vérifie, puis ferme; Windows demande la permission, et "
"l'installation l'installe et démarre le jeu à nouveau. Progrès depuis que "
"votre dernière sauvegarde est perdue; les paramètres, cartes mémoire et "
"états de sauvegarde sont conservés."

#: port/src/ui/updates.cpp
#, c-format
msgid ""
"Install Xenogears PC port %s now? The app downloads it and checks it; "
"Android then installs it over this app (it may ask you to confirm first) "
"and closes the app: open it again afterwards. Progress since your last save "
"is lost; the settings, memory cards and save states are kept."
msgstr ""
"Installez Xenogears PC port %s maintenant? L'application le télécharge et "
"le vérifie; Android l'installe ensuite sur cette application (il peut vous "
"demander de confirmer d'abord) et ferme l'application: l'ouvrir de nouveau "
"après. Progress depuis que votre dernière sauvegarde est perdue; les "
"paramètres, les cartes mémoire et les états de sauvegarde sont conservés."

#: port/src/ui/updates.cpp
#, c-format
msgid ""
"Install Xenogears PC port %s now? The game downloads it, checks it, puts it "
"in place of this copy's files and starts again. Progress since your last "
"save is lost; the settings, memory cards and save states are kept."
msgstr ""
"Installez le port PC Xenogears %s maintenant? Le jeu le télécharge, le "
"vérifie, le remplace par les fichiers de cette copie et recommence. "
"Progressez depuis que votre dernière sauvegarde est perdue; les paramètres, "
"les cartes mémoire et les états de sauvegarde sont conservés."

#: port/src/ui/updates.cpp
msgid ""
"Allow installs from this app in the settings Android opened, then choose "
"Install and restart again."
msgstr ""
"Autoriser l'installation depuis cette application dans les paramètres "
"Android ouverts, puis choisir Installer et redémarrer à nouveau."

#: port/src/ui/updates.cpp
msgid "Look for a new version of the port once a day?"
msgstr "Vous cherchez une nouvelle version du port une fois par jour ?"

#: port/src/ui/updates.cpp
msgid ""
"The game would ask GitHub for the latest release's small signed file; "
"nothing about you is sent. A new version shows in a corner note and in F1, "
"System, Updates, where this can be changed."
msgstr ""
"Le jeu demanderait GitHub pour le petit fichier signé de la dernière "
"version; rien sur vous n'est envoyé. Une nouvelle version affiche dans une "
"note de coin et dans F1 , Système, Mises à jour, où cela peut être modifié."

#: port/src/ui/updates.cpp
msgid "Cancel: ask again at the next start."
msgstr "Annuler : redemandez au prochain départ."

#: port/src/ui/updates.cpp
msgid "Updates"
msgstr "Mises à jour"

#: port/src/ui/updates.cpp
msgid "New version"
msgstr "Nouvelle version"

#: port/src/ui/updates.cpp
#, c-format
msgid "Xenogears PC port %s is out (this is %s)."
msgstr "Xenogears port PC %s est sorti (c'est %s )."

#: port/src/ui/updates.cpp
msgid "Open the release page"
msgstr "Ouvrir la page de publication"

#: port/src/ui/updates.cpp
msgid "Skip this version"
msgstr "Sauter cette version"

#: port/src/ui/updates.cpp
msgid ""
"Install and restart downloads it and checks it against the signed manifest; "
"Android installs it over this app (it may ask you to confirm first), "
"keeping its settings and saves. Skipped, it is not shown again; a later "
"version is."
msgstr ""
"Installez et redémarrez le télécharge et vérifiez-le par rapport au "
"manifeste signé; Android l'installe sur cette application (il peut vous "
"demander de confirmer d'abord), en gardant ses paramètres et sauvegardes."

#: port/src/ui/updates.cpp
msgid ""
"Install and restart downloads it, checks it against the signed manifest, "
"puts it in place of this copy's files and starts the game again; the "
"settings and saves are kept. Skipped, it is not shown again; a later "
"version is."
msgstr ""
"Installer et redémarrer le téléchargement, le vérifier contre le manifeste "
"signé, le mettre à la place des fichiers de cette copie et recommencer le "
"jeu ; les paramètres et sauvegardes sont conservés. Passé, il n'est pas "
"montré à nouveau ; une version ultérieure est."

#: port/src/ui/updates.cpp
msgid ""
"apt installs it: sudo apt update && sudo apt upgrade, once this port's APT "
"repository is added (the Build and set up page says how). Skipped, it is "
"not shown again; a later version is."
msgstr ""
"apt l'installe : sudo apt update && sudo apt upgrade, une fois que le dépôt "
"APT de ce port est ajouté (la page Construire et configurer dit comment)."

#: port/src/ui/updates.cpp
msgid ""
"Its release page has the downloads. Skipped, it is not shown again; a later "
"version is."
msgstr ""
"Sa page de sortie a les téléchargements. Passé, il n'est pas montré à "
"nouveau; une version ultérieure est."

#: port/src/ui/updates.cpp
msgid ""
"Your package manager installs it: its release page has the new package. "
"Skipped, it is not shown again; a later version is."
msgstr ""
"Votre gestionnaire de paquets l'installe: sa page de sortie a le nouveau "
"paquet. Passé, il n'est pas montré à nouveau; une version ultérieure est."

#: port/src/ui/updates.cpp
msgid "Check for updates"
msgstr "Vérifier les mises à jour"

#: port/src/ui/updates.cpp
msgid ""
"Once a day at most, the game asks GitHub for the latest release's update "
"file and its signature (two small files); nothing about you is sent. A new "
"version shows here and in a corner note. Ask: the question before the game, "
"at the next start."
msgstr ""
"Une fois par jour au plus, le jeu demande GitHub pour le fichier de mise à "
"jour de la dernière version et sa signature (deux petits fichiers); rien "
"sur vous n'est envoyé. Une nouvelle version affiche ici et dans une note de "
"coin. Poser: la question avant le jeu, au prochain départ."

#: port/src/ui/updates.cpp
msgid "This is a development build: it never checks."
msgstr "C'est une construction de développement : elle ne vérifie jamais."

#: port/src/ui/updates.cpp
msgid "Not in this run (headless, or an online session)."
msgstr "Pas dans cette course (sans tête, ou une session en ligne)."

#: port/src/ui/updates.cpp
#, c-format
msgid "No check is possible: %s."
msgstr "Aucune vérification n'est possible : %s."

#: port/src/ui/updates.cpp
msgid "Last check"
msgstr "Dernier contrôle"

#: port/src/ui/updates.cpp
msgid "Checking..."
msgstr "Vérification..."

#: port/src/ui/updates.cpp
#, c-format
msgid "Last checked %s."
msgstr "Dernière vérification %s."

#: port/src/ui/updates.cpp
msgid "Not checked yet."
msgstr "Pas encore vérifié."

#: port/src/ui/updates.cpp
#, c-format
msgid "%s: version %s found."
msgstr "%s : version %s trouvée."

#: port/src/ui/updates.cpp
#, c-format
msgid "%s: this is the latest release."
msgstr "%s : c'est la dernière version."

#: port/src/ui/updates.cpp
#, c-format
msgid "%s: version %s, skipped."
msgstr "%s : version %s , sauté."

#: port/src/ui/updates.cpp
#, c-format
msgid "%s: no update is offered yet."
msgstr "%s : aucune mise à jour n'est encore proposée."

#: port/src/ui/updates.cpp
#, c-format
msgid "%s: the latest release has no update file."
msgstr "%s : la dernière version n'a aucun fichier de mise à jour."

#: port/src/ui/updates.cpp
#, c-format
msgid ""
"%s: the update file is not signed by the release key: nothing is offered."
msgstr ""
"%s : le fichier de mise à jour n'est pas signé par la clé de sortie : rien "
"n'est offert."

#: port/src/ui/updates.cpp
#, c-format
msgid "%s: the update file is of a kind this build cannot read."
msgstr ""
"%s : le fichier de mise à jour est d'un type que cette compilation ne peut "
"pas lire."

#: port/src/ui/updates.cpp
#, c-format
msgid "%s: no check is possible on this system."
msgstr "%s : aucun contrôle n'est possible sur ce système."

#: port/src/ui/updates.cpp
#, c-format
msgid "%s: the check failed."
msgstr "%s : la vérification a échoué."

#: port/src/ui/updates.cpp
msgid "Check now"
msgstr "Vérifiez maintenant"

#: port/src/ui/updates.cpp
msgid ""
"Check now looks at once, whenever the last check was. Only while checks are "
"on."
msgstr ""
"Vérifiez maintenant à la fois, chaque fois que la dernière vérification a "
"été. Seulement pendant que les vérifications sont en cours."
