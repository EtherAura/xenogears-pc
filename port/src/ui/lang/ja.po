msgstr "%s は 512 KB の PS1 BIOS イメージではありません。"

#: port/src/ui/sections.cpp
msgid "Starting with these images; settings could not be saved."
msgstr "このイメージで始めます。設定は保存できませんでした。"

#: port/src/ui/sections.cpp
msgid "Language"
msgstr "言語"

#: port/src/ui/sections.cpp
msgid ""
"This menu and the extras. The game's own text stays as the disc has it. "
"Text not yet translated shows in English."
msgstr "このメニューとおまけの言語です。ゲーム本来の文字はディスクのままです。まだ訳されていない文字は英語で表示します。"

#: port/src/ui/sections.cpp
#, c-format
