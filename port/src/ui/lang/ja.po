msgstr "未フォーマット(ゲームがセーブするときにフォーマットします)"

#: port/src/ui/sections.cpp
#, c-format
msgid "%d save%s, %d free block%s"
msgstr "%d 件%.0s、空き %d ブロック%.0s"

#: port/src/ui/sections.cpp
msgid "Blocks"
msgstr "ブロック"

#: port/src/ui/sections.cpp
msgid "Single save"
msgstr "単体のセーブ"

#: port/src/ui/sections.cpp
msgid "Import"
msgstr "取り込む"

#: port/src/ui/sections.cpp
msgid "Export to this file"
msgstr "このファイルに書き出す"

