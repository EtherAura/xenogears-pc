msgstr ""
"Os cartões de memória ficam disponíveis quando uma imagem de disco é "
"selecionada."

#: port/src/ui/sections.cpp
msgid "Save states become available once the game is running."
msgstr ""
"Os estados de salvamento ficam disponíveis quando o jogo está em andamento."

#: port/src/ui/sections.cpp
msgid "Extras become available once a disc image is selected."
msgstr ""
"Extras ficam disponíveis uma vez que uma imagem de disco é selecionada."

#: port/src/ui/shaders.cpp
#, c-format
msgid ""
"%d pass%s. RetroArch .slangp presets and .slang shaders (not .glslp or "
".cgp)."
msgstr ""
"%d passe %s. RetroArch.slangp predefinições e slang shaders (não glslp ou "
"cgp)."

