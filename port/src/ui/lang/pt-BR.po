#: port/src/ui/gametext.cpp
msgid ""
"Changes dialogue, menus, names, battle labels and movie subtitles together. "
"Reopen the game menu or enter a new battle to refresh its labels."
msgstr ""
"Altera diálogos, menus, nomes, textos de batalha e legendas dos vídeos. "
"Reabra o menu do jogo ou entre em outra batalha para atualizar os textos."

#: port/src/ui/gametext.cpp
msgid "This source has no separate movie subtitle track."
msgstr "Essa fonte não tem legendas de filme separadas."

#: port/src/ui/gametext.cpp
msgid ""
"Movie subtitles use the English translation of the Japanese dialogue."
msgstr "Legendas de filmes usam a tradução em inglês do diálogo japonês."

#: port/src/ui/gametext.cpp
msgid "Battle text"
msgstr "Texto de batalha"

#: port/src/ui/gametext.cpp
