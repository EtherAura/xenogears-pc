msgstr "%s : versão %s , pulou."

#: port/src/ui/updates.cpp
#, c-format
msgid "%s: no update is offered yet."
msgstr "%s : nenhuma atualização é oferecida ainda."

#: port/src/ui/updates.cpp
#, c-format
msgid "%s: the latest release has no update file."
msgstr "%s : a última versão não tem nenhum arquivo de atualização."

#: port/src/ui/updates.cpp
#, c-format
msgid ""
"%s: the update file is not signed by the release key: nothing is offered."
msgstr ""
"%s : o arquivo de atualização não é assinado pela chave de lançamento: nada "
"é oferecido."

#: port/src/ui/updates.cpp
#, c-format
msgid "%s: the update file is of a kind this build cannot read."
msgstr ""
"%s : o arquivo de atualização é de um tipo que esta compilação não pode ler."

#: port/src/ui/updates.cpp
#, c-format
msgid "%s: no check is possible on this system."
msgstr "%s : nenhuma verificação é possível neste sistema."

#: port/src/ui/updates.cpp
#, c-format
msgid "%s: the check failed."
msgstr "%s : a verificação falhou."

#: port/src/ui/updates.cpp
msgid "Check now"
msgstr "Verifica agora."

#: port/src/ui/updates.cpp
msgid ""
"Check now looks at once, whenever the last check was. Only while checks are "
"on."
msgstr ""
"Verifique agora olhar de uma vez, sempre que a última verificação foi. "
"Apenas enquanto a verificação está em."
