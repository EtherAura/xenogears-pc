#version 450
#extension GL_GOOGLE_include_directive : require
#define ORDERED_SET 1
#ifdef DEPTH
#define ORDERED_DEPTH
#endif
#include "ordered.glsl"
#include "hdr.glsl"
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0,r16ui) uniform uimage2D vram;
layout(set=0,binding=2,r16ui) uniform uimage2D wideImg;
layout(set=0,binding=3,r32ui) uniform uimage2D hiVram;
layout(set=0,binding=4,r32ui) uniform uimage2D hiWide;
#ifdef DEPTH
// A registered scene's batch (vk.c drawOrdered): the scene's depth image and
// where the target's pixels fall in it, as hires.frag's depthOrigin/Size.
layout(set=2,binding=0,r32ui) uniform uimage2D sceneDepth;
#endif
#ifdef ORDERED_MSAA
// The scratch is shared across bands, but all triangle groups in one band
// see the same epoch and retain the original samples through each resolve.
layout(set=3,binding=0,std430) buffer SampleScratch { uint scratch[]; };
#endif
#if defined(DEPTH) || defined(ORDERED_MSAA)
layout(push_constant) uniform Resolve {
    ivec2 origin;
    ivec2 size;
#ifdef ORDERED_MSAA
    ivec2 sampleOrigin;
    uint sampleStride;
    uint sampleEpoch;
    uint sampleCount;
    uint sampleBase;
#endif
} pc;
#endif
ivec3 ordRgb5(uint v){return ivec3(v&31u,v>>5&31u,v>>10&31u);}
ivec3 ordRgb8(uint v){return ivec3(v&255u,v>>8&255u,v>>16&255u);}
ivec3 ordExpand5(ivec3 v){return (v<<3)|(v>>2);}
uint ordPack5(ivec3 v){return uint(v.r)|uint(v.g)<<5|uint(v.b)<<10;}
uint ordPack8(ivec3 v){return uint(v.r)|uint(v.g)<<8|uint(v.b)<<16;}
// The operation is not held back by the mask bit or, for a fringe, by the
// pixel already being covered: it writes the pixel.
bool ordWrites(uint dst,uvec4 op,bool native) {
    uint flags=op.w,mask=native?32768u:0x1000000u,covered=0x2000000u;
    return !(((flags&ORD_CHECK)!=0u&&(dst&mask)!=0u)||
             (!native&&(flags&ORD_FRINGE)!=0u&&(dst&covered)!=0u));
}
uint ordApply(uint dst,uvec4 op,bool native) {
    uint flags=op.w,mask=native?32768u:0x1000000u,covered=0x2000000u;
    if(!ordWrites(dst,op,native))return dst;
    bool quant=(flags&ORD_QUANT5)!=0u;
    ivec3 f=quant?ordRgb5(op.z):ordRgb8(op.z);
    ivec3 b=native?ordRgb5(dst):quant?ordRgb8(dst)>>3:ordRgb8(dst);
    uint blend=flags&7u;
    ivec3 c=f;
    if(blend==1u)c=(b+f)>>1;
    else if(blend==2u)c=b+f;
    else if(blend==3u)c=b-f;
    else if(blend==4u)c=b+((flags&ORD_QUARTER5)!=0u?ordExpand5((f>>3)>>2):f>>2);
    c=clamp(c,0,quant?31:255);
    uint cover=(flags>>ORD_COVER_SHIFT)&255u;
    if(cover!=0u)c=ivec3(floor(mix(vec3(b),vec3(c),float(cover)/255.0)+0.5));
    uint color=native?ordPack5(c):ordPack8(quant?ordExpand5(c):c);
    uint coverage=native?0u:dst&covered;
    if(!native) {
        if((flags&(ORD_SURFACE|ORD_FRINGE))!=0u)coverage=covered;
        else if((flags&ORD_CLEAR)!=0u)coverage=0u;
    }
    uint emission = native ? 0u : ((flags >> ORD_HDR_SHIFT) & 63u) << HDR_SHIFT;
    if (emission != 0u) emission = max(emission, dst & HDR_MASK);
    return color|((flags&ORD_MASK)!=0u?mask:0u)|coverage|emission;
}
void main() {
    ivec2 q=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(q,ordered.grid)))return;
    uint next=head[uint(q.y*ordered.grid.x+q.x)];
    if(next==0xffffffffu)return;
    ivec2 p=q+ordered.origin;uint dst;
    uint kind=ordered.targetKind;
    if(kind==0u)dst=imageLoad(vram,p).r;
    else if(kind==1u)dst=imageLoad(wideImg,p).r;
    else if(kind==2u)dst=imageLoad(hiVram,p).r;
    else dst=imageLoad(hiWide,p).r;
#ifdef ORDERED_MSAA
    ivec2 sp = p - pc.sampleOrigin;
    uint point = uint(sp.y) * pc.sampleStride + uint(sp.x);
    uint sampleAt = pc.sampleBase + point * pc.sampleCount;
    uint allSamples = (1u << pc.sampleCount) - 1u;
    bool split = scratch[point] == pc.sampleEpoch;
    uint words[4];
    if (split) for (uint s = 0u; s < pc.sampleCount; ++s) words[s] = scratch[sampleAt + s];
#endif
    // Keep only eight indices live per lane. Long overdraw is resolved in
    // sorted chunks; short lists avoid a 64-entry array's register pressure.
    uint ids[8],last=0u;bool haveLast=false;
#ifdef DEPTH
    uint z=0u;bool haveZ=false;
#endif
    for(int chunk=0;chunk<8;chunk++) {
        int n=0,visited=0;uint at=next;
        while(at!=0xffffffffu&&visited<64) {
            uvec4 op=ordered.operation[at];uint order=op.y;
            if(!haveLast||order>last) {
                int j=n;
                while(j>0&&ordered.operation[ids[j-1]].y>order) {
                    if(j<8)ids[j]=ids[j-1];j--;
                }
                if(j<8)ids[j]=at;
                n=min(n+1,8);
            }
            visited++;at=op.x;
        }
        if(at!=0xffffffffu){atomicAdd(ordered.overflow,1u);return;}
        for(int k=0;k<n;k++) {
            uvec4 op=ordered.operation[ids[k]];
#ifdef ORDERED_MSAA
            uint mask = (op.w >> ORD_SAMPLE_SHIFT) & allSamples;
#ifdef DEPTH
            if ((mask & 1u) != 0u && (op.w & ORD_DEPTH) != 0u && ordWrites(split ? words[0] : dst, op, false)) {
                z = opDepth[ids[k]];
                haveZ = true;
            }
#endif
            if (!split && mask == allSamples) {
                dst = ordApply(dst, op, false);
            } else if (mask != 0u) {
                if (!split) for (uint s = 0u; s < pc.sampleCount; ++s) words[s] = dst;
                split = true;
                for (uint s = 0u; s < pc.sampleCount; ++s)
                    if ((mask & (1u << s)) != 0u) words[s] = ordApply(words[s], op, false);
            }
#else
#ifdef DEPTH
            if((op.w&ORD_DEPTH)!=0u&&ordWrites(dst,op,kind<2u)){z=opDepth[ids[k]];haveZ=true;}
#endif
            dst=ordApply(dst,op,kind<2u);
#endif
        }
        if(n<8)break;
        last=ordered.operation[ids[7]].y;haveLast=true;
    }
#ifdef DEPTH
    ivec2 dp=p-pc.origin;
    if(haveZ&&all(greaterThanEqual(dp,ivec2(0)))&&all(lessThan(dp,pc.size)))imageStore(sceneDepth,dp,uvec4(z));
#endif
#ifdef ORDERED_MSAA
    if (split) {
        ivec3 sum = ivec3(0);
        uint energy = 0u;
        for (uint s = 0u; s < pc.sampleCount; ++s) {
            uint word = words[s];
            scratch[sampleAt + s] = word;
            sum += ordRgb8(word);
            energy += word >> HDR_SHIFT;
        }
        scratch[point] = pc.sampleEpoch;
        uint hdr = ((energy + pc.sampleCount / 2u) / pc.sampleCount) << HDR_SHIFT;
        dst = ordPack8((sum + int(pc.sampleCount / 2u)) / int(pc.sampleCount)) |
              (words[0] & 0x03000000u) | hdr;
    }
#endif
    if(kind==0u)imageStore(vram,p,uvec4(dst));
    else if(kind==1u)imageStore(wideImg,p,uvec4(dst));
    else if(kind==2u)imageStore(hiVram,p,uvec4(dst));
    else imageStore(hiWide,p,uvec4(dst));
}
