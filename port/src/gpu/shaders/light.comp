#version 450
#extension GL_GOOGLE_include_directive : require

// Scene lighting over one frame of the hi-res copy (port/src/gpu/scene.c,
// vk.c sceneLightRecord; docs/PORT_HD2D.md sections 14, 15). It runs where
// the depth of field does, before it: after the scene's last packet, before
// the first packet of the UI. Written from the textbook pieces named below
// and our own prototype (work/hd2d/light); no other project's code.
//
// Inputs: the copy's frame (8:8:8 colour in bits 0-23; the mask and coverage
// bits above pass through) and the scene's depth image (hires.frag DEPTH:
// view depth in 1/16 units, bit 30 set for a figure (a sprite), 0 a picture
// kept as it is, all ones nothing drawn).
//
// The rooms give no light to work with (694 of 730 field headers hold none,
// and the scenery is pre-lit), so all four parts come from the picture and
// its depth:
//   top light  scenery that faces up gets brighter, scenery that faces down
//              darker, upright surfaces stay as they are: the light is
//              overhead, where the blob shadow under every character says
//              it is. The surface normal is the cross product of a pixel's
//              neighbours in view space, softened along the surface;
//   shade      how much nearby scenery fills the half-space above a pixel
//              (the usual screen-space occlusion estimate): creases, corners
//              and the ground under an overhang;
//   bounce     a pixel that stands out as bright against its surroundings is
//              a small light at its own place in the scene, and lights what
//              is near it by distance and facing;
//   glow       light above a high threshold, spread softly;
//   shadows    cast by a sun set per room (scene.c): the scenery's marched
//              through the depth image toward the sun, the characters' laid
//              on the ground from where the game lays its own shadow, each
//              sprite as if it turned to face the sun (docs/PORT_HD2D.md
//              section 20).
// Figures (sprites) get no top light and no occlusion shade, cast none, and
// are no source of bounce or glow; bounce, glow and the scenery's cast
// shadows fall on them, and they cast their own shadows as silhouettes. A
// distant backdrop (far behind the focus, by the depth of field's measure) is
// a painting: neither lit, shaded nor a source.
//
// Everything but the last pass is made on the PS1's own pixel grid or on a
// quarter of it, in PS1 pixels and view units, so the look does not depend
// on N:
//   0      prepare: the mean light of each PS1 pixel, its glow source, and
//          the normal and depth at its centre;
//   1-3    on the quarter grid: the mean brightness of the surroundings, and
//          the glow's two wide spreads;
//   4      the bounce sources;
//   5, 6   the normals softened across and down;
//   7      top light and shade;
//   8, 9   the shade smoothed along surfaces;
//   10, 11 on the quarter grid: the sources summed, then gathered by each
//          quarter pixel within its reach (every one of them: no noise);
//   12, 13 the glow's narrow spread, and the wide ones added;
//   14     the scenery's cast shadows, marched toward the sun;
//   15     the characters' shadows, laid on the ground;
//   16, 17 the shadows smoothed along surfaces;
//   18     the fog's colour: one group sums the grid into the frame's block;
//   22, 23 light shafts, on the quarter grid: their sources, then each
//          quarter pixel gathers them back toward the sun;
//   19     composite at the copy's resolution. Top light, shade and bounce
//          are read from the grid pixels around: filtered where those lie on
//          the pixel's own surface (their filtered depth is the pixel's),
//          else one by one, weighted by how close their depth is to the
//          pixel's, so they stop at an object's outline. The same passes'
//          results serve both copies of a frame drawn wide (the copy of VRAM
//          reads them at `layer`).
// Fog and the colour grade (docs/PORT_HD2D.md section 27) come last, on the
// shown colour: fog thickens past the focus by depth toward a colour from
// the room's own farthest scenery; the grade cools the shadows and warms the
// highlights a little. Then light shafts (xg-rgcf.5.16): what is much
// brighter than the room (a window, an opening, the sky behind) spills light
// down along the sun's way across the screen, in bands, and soft sunbeams
// slant down from the top of the frame over the scenery; both are added as
// light (a screen blend, never past white).
// Colours are worked on as light (the squared 8-bit value).

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, r32ui) uniform uimage2D color;
layout(set = 0, binding = 1, r32ui) uniform readonly uimage2D depth;
layout(set = 0, binding = 2, rgba16f) uniform image2D base;    // rgb: mean light, a: its brightness
layout(set = 0, binding = 3, rgba16f) uniform image2D glow;    // the glow's source, then the glow
layout(set = 0, binding = 4, rgba16f) uniform image2D geo;     // xyz: normal (view space), a: depth code
layout(set = 0, binding = 5, rgba16f) uniform image2D tempA;
layout(set = 0, binding = 6, rgba16f) uniform image2D tempB;
layout(set = 0, binding = 7, rgba16f) uniform image2D tempC;
layout(set = 0, binding = 8, rgba16f) uniform image2D terms;   // r: top light, g: shade, b: depth code, a: backdrop fade
layout(set = 0, binding = 9, rgba16f) uniform image2D shadowImg; // r: cast shadow, b: depth code
// The quarter grid.
layout(set = 0, binding = 10, rgba16f) uniform image2D quarterA;     // the surroundings' brightness
layout(set = 0, binding = 11, rgba16f) uniform image2D quarterB;
layout(set = 0, binding = 12, rgba16f) uniform image2D quarterE;    // rgb: the sources summed, a: their depth
layout(set = 0, binding = 13, rgba16f) uniform image2D quarterPool; // rgb: the bounce light, a: the depth it was gathered at
layout(set = 0, binding = 14, rgba16f) uniform image2D quarterGlow; // the glow's source
layout(set = 0, binding = 15, rgba16f) uniform image2D quarterWide; // the glow's wide spreads
// Read with bilinear filtering.
layout(set = 0, binding = 16) uniform sampler2D surround;    // quarterA
layout(set = 0, binding = 17) uniform sampler2D poolLayer;   // quarterPool
layout(set = 0, binding = 18) uniform sampler2D glowLayer;   // glow
layout(set = 0, binding = 19) uniform sampler2D termsLayer;  // terms
layout(set = 0, binding = 20) uniform sampler2D wideLayer;   // quarterWide
layout(set = 0, binding = 21) uniform sampler2D castLayer;   // shadowImg
// The frame's span buffer: at block (pc.lens.w, in vec4s) the sun and the
// shadow's darkness, the count of ground points, then the ground points
// (vk.c lightBlock).
// The fog's colour is written there too (FOG_SLOT), by pass 18.
layout(std430, set = 0, binding = 22) buffer Spans { vec4 block[]; };
// The same buffer as words: the particles' tile masks, set with atomicOr.
layout(std430, set = 0, binding = 22) buffer SpanWords { uint words[]; };

layout(push_constant) uniform Light {
    int pass;
    int n;         // the copy's pixels per PS1 pixel
    int taps;      // prepare's samples per PS1 pixel, each way (at most n)
    int flags;     // DEBUG: the parts as colours instead of the lit picture; ALL: every part is read, at strength 0 too
    ivec2 origin;  // the frame's first pixel in `color`
    ivec2 size;    // the frame, in the copy's pixels (the depth image's used size)
    ivec2 work;    // the layers' used size (the frame they were made from, PS1 pixels)
    ivec2 layer;   // this frame's first PS1 pixel in the layers
    vec4 view;     // xyz: the room's up in view space; w: the projection distance
    vec4 lens;     // xy: the projection centre in the frame, PS1 pixels; z: the focus depth; w: the shadows' block, or -1
    vec4 strength; // top light, shade, bounce, glow
    int color;     // the copy's colour mode (scene_color.glsl)
    int vignette;  // how much darker the frame's corners are, in 1/4096 (0: no vignette, xg-rgcf.5.13)
    ivec2 ditherOrigin; // scene_color.glsl
    vec4 atmos;    // x: the most of a pixel the fog takes (0: no fog), y: how quickly it thickens, z: the grade,
                   // w: the farthest past the focus it thickens to (relative depth; 0: no cap)
} pc;

#include "scene_color.glsl"
#include "tilt_shift.glsl"

const uint DEPTH_SHARP = 0u;
const uint DEPTH_FAR = 0xFFFFFFFFu;
const uint DEPTH_FIGURE = 0x40000000u;
const int DEBUG = 1, ALL = 2;

// A depth code fits a 16-bit float: the view depth for scenery, its negative
// for a figure, 0 where there is none (nothing drawn, or a kept picture).
const float DEPTH_LIMIT = 60000.0;

// The distant backdrop: full effect up to a relative depth of 0.30 behind the
// focus (1 - focus / z, the depth of field's measure), none from 0.45.
const float FADE_FROM = 0.30, FADE_TO = 0.45;
// Glow: the 8-bit values where a source starts and is whole, the spreads in
// PS1 pixels and their shares.
const float GLOW_FROM = 0.74, GLOW_TO = 1.0, GLOW_GAIN = 0.9;
const vec3 GLOW_SHARE = vec3(0.45, 0.35, 0.20);
// The spreads are Gaussians of 1.2, 3.5 and 8 PS1 pixels. The two wide ones
// are made on the quarter grid, where the 4x4 mean before and the filtered
// read after add 4 square pixels of spread of their own: 0.72 and 1.94
// quarter pixels then make 3.5 and 8.
const float GLOW_NARROW = 1.2;
const vec2 GLOW_WIDE = vec2(0.72, 1.94);
// Bounce: a source is light above BOUNCE_RATIO times its surroundings' mean
// (SURROUND_SIGMA PS1 pixels), and above a floor; the reach in PS1 pixels at
// the focus depth.
const float BOUNCE_RATIO = 2.6, BOUNCE_FLOOR = 0.16, SURROUND_SIGMA = 14.0;
const float BOUNCE_REACH = 40.0, BOUNCE_WRAP = 0.3, BOUNCE_GAIN = 0.012, BOUNCE_FIGURE = 0.6;
const int BOUNCE_SCAN = 16; // quarter pixels each way, at most
// Shade: the reach in PS1 pixels at the focus depth, the samples around.
const float SHADE_REACH = 14.0, SHADE_BIAS = 0.05, SHADE_GAIN = 4.4, SHADE_MOST = 0.85;
const int SHADE_DIRS = 8, SHADE_STEPS = 4;
// Top light: how much an up-facing and a down-facing surface change, and how
// quickly a surface counts as facing up or down: 3 times the cosine of its
// angle to the vertical, at most 1 (anything within about 70 degrees of
// facing up is lit fully). That is the response of the pictures agreed for
// this slice (docs/PORT_HD2D.md section 16): the prototype took the field's
// projection matrix, a rotation times 3, as the up direction.
const float TOP_UP = 0.55, TOP_DOWN = 0.9, TOP_RESPONSE = 3.0;
// Shadows: the reach of a march toward the sun in PS1 pixels at the focus
// depth, its steps, and how far behind a caster a step may be and still be
// shadowed (a share of the reach). Characters: how far from its foot a
// sprite's pixel may be (PS1 pixels at the foot; depth as a share), and how
// near the ground there must be to the shadow's depth; how high up the sprite
// (PS1 pixels at the foot) its shadow has faded from the feet, and to what
// (xg-rgcf.5.7: carl chose the fading shadow). The most dark.
const float SHADOW_REACH = 48.0, SHADOW_THICK = 0.25, SHADOW_MOST = 0.85;
// What is painted this bright (light, the squared 8-bit value) is a light: no shadow from here, none at all from there.
const float SHADOW_KEEP_FROM = 0.45, SHADOW_KEEP_TO = 0.75;
const int SHADOW_STEPS = 24, MAX_FIGURES = 32;
// Fog: its colour's place in the frame's block (after the sun, the count and
// MAX_FIGURES ground points: vk.c LIGHT_BLOCK_BYTES); the relative depth past
// which scenery counts as far for that colour, and where wholly; the
// neutral the colour is taken half way to.
const int FOG_SLOT = 2 + MAX_FIGURES;
// Light shafts (xg-rgcf.5.16, carl chose the streaked beams with sunbeams
// from the prototypes, work/hd2d/light/proto17.py): their settings' place in
// the block (x: their strength, 0 none; y: the frame's time in seconds; vk.c
// lightBlock); a source is brighter than SHAFT_RATIO times the room's shown
// brightness (at least SHAFT_FLOOR, at most SHAFT_CEIL), or the far backdrop
// (the sky: SHAFT_FAR_FROM to SHAFT_FAR_TO behind the focus, by the depth of
// field's measure) where it is not dark; the march back toward the sun, in
// quarter pixels, and how quickly it fades; the beams' and the sunbeams'
// shares; the sunbeams' colour and how far down the frame they reach (a share
// of its height).
const int SHAFT_SLOT = 3 + MAX_FIGURES;
const float SHAFT_RATIO = 1.7, SHAFT_FLOOR = 0.45, SHAFT_CEIL = 0.85, SHAFT_SOFT = 0.3;
const float SHAFT_FAR_FROM = 0.44, SHAFT_FAR_TO = 0.50;
const int SHAFT_STEPS = 16;
const float SHAFT_FADE = 2.5, SHAFT_BEAMS = 1.1, SHAFT_SUN = 0.16, SHAFT_REACH = 0.55;
const vec3 SUN_COLOUR = vec3(1.0, 0.94, 0.80);
const float FOG_FAR_FROM = 1.2, FOG_FAR_TO = 3.0;
const vec3 FOG_NEUTRAL = vec3(0.66, 0.70, 0.76);
// The vignette starts darkening this far from the middle (of the way to the corners).
const float VIGNETTE_FROM = 0.45;
const float FIGURE_HEIGHT = 96.0, FIGURE_WIDTH = 32.0, FIGURE_DEPTH = 0.15, GROUND_DEPTH = 0.05;
const float FIGURE_FADE = 0.8 * FIGURE_HEIGHT, FIGURE_FADE_TO = 0.15;

vec3 light(uint word) {
    vec3 c = vec3(float(word & 255u), float((word >> 8) & 255u), float((word >> 16) & 255u)) / 255.0;
    return c * c;
}

float depthCode(uint raw) {
    if (raw == DEPTH_SHARP || raw == DEPTH_FAR) return 0.0;
    float z = min(float(raw & ~DEPTH_FIGURE) / 16.0, DEPTH_LIMIT);
    return (raw & DEPTH_FIGURE) != 0u ? -z : z;
}

float backdropFade(float z) {
    if (z <= 0.0) return 0.0;
    float u = 1.0 - pc.lens.z / z;
    return clamp((FADE_TO - u) / (FADE_TO - FADE_FROM), 0.0, 1.0);
}

// The view-space place of a point of the frame (PS1 pixels) at view depth z:
// x right, y down, z into the picture.
vec3 place(vec2 at, float z) {
    return vec3((at - pc.lens.xy) * z / pc.view.w, z);
}

// The same for a pixel of the copy, from the depth image; z <= 0: no scenery there.
vec3 placeAt(ivec2 l, out float code) {
    code = l.x < 0 || l.y < 0 || l.x >= pc.size.x || l.y >= pc.size.y ? 0.0 : depthCode(imageLoad(depth, l).r);
    return place((vec2(l) + 0.5) / float(pc.n), abs(code));
}

ivec2 inside(ivec2 t) { return clamp(t, ivec2(0), pc.work - 1); }

// The pixel of the copy that stands for PS1 pixel t (its middle), and where
// that is in the frame, in PS1 pixels.
ivec2 middle(ivec2 t) { return min(t * pc.n + pc.n / 2, pc.size - 1); }
vec2 middleAt(ivec2 t) { return (vec2(middle(t)) + 0.5) / float(pc.n); }

// The quarter grid: its used size, the PS1 pixel that stands for quarter
// pixel q, and where a point of the frame (PS1 pixels) falls in a quarter
// image read with filtering (q's value belongs at that PS1 pixel's middle).
ivec2 quarters() { return (pc.work + 3) / 4; }
ivec2 quarterMiddle(ivec2 q) { return min(q * 4 + 2, pc.work - 1); }
vec2 quarterUv(vec2 at, sampler2D image) {
    return clamp((at - 0.5) / 4.0, vec2(0.5), vec2(quarters()) - 0.5) / vec2(textureSize(image, 0));
}

// A value in [0, 1) that differs from pixel to pixel in a fixed pattern
// (interleaved gradient noise): it turns each pixel's ring of samples.
float turn(ivec2 t) {
    return fract(52.9829189 * fract(0.06711056 * float(t.x) + 0.00583715 * float(t.y)));
}

void prepare(ivec2 t) {
    vec3 sum = vec3(0.0), source = vec3(0.0);
    float count = 0.0;
    for (int y = 0; y < pc.taps; y++) for (int x = 0; x < pc.taps; x++) {
        ivec2 l = t * pc.n + (ivec2(x, y) * 2 + 1) * pc.n / (2 * pc.taps);
        if (l.x >= pc.size.x || l.y >= pc.size.y) continue;
        vec3 c = light(imageLoad(color, pc.origin + l).r);
        float code = depthCode(imageLoad(depth, l).r);
        sum += c;
        count += 1.0;
        if (code > 0.0) {
            float peak = max(c.r, max(c.g, c.b));
            float k = clamp((peak - GLOW_FROM * GLOW_FROM) / (GLOW_TO * GLOW_TO - GLOW_FROM * GLOW_FROM), 0.0, 1.0);
            source += c * (k * k * (3.0 - 2.0 * k) * backdropFade(code));
        }
    }
    count = max(count, 1.0);
    sum /= count;
    imageStore(base, t, vec4(sum, dot(sum, vec3(0.2126, 0.7152, 0.0722))));
    imageStore(glow, t, vec4(source / count, 0.0));

    // The surface at the PS1 pixel's centre: the cross product of the steps
    // to its neighbours in the copy, each taken on the side where the depth
    // changes less (an outline then does not bend the normal).
    ivec2 l = middle(t);
    float code, ca, cb;
    vec3 p = placeAt(l, code);
    vec3 normal = vec3(0.0, 0.0, -1.0);
    if (code > 0.0) {
        vec3 step2[2];
        bool have = true;
        for (int axis = 0; axis < 2; axis++) {
            ivec2 d = axis == 0 ? ivec2(1, 0) : ivec2(0, 1);
            vec3 a = placeAt(l + d, ca) - p, b = p - placeAt(l - d, cb);
            bool okA = ca > 0.0, okB = cb > 0.0;
            if (!okA && !okB) have = false;
            step2[axis] = okA && (!okB || abs(a.z) < abs(b.z)) ? a : b;
        }
        if (have) {
            vec3 c = cross(step2[0], step2[1]);
            float len = length(c);
            if (len > 1.0e-9) {
                normal = c / len;
                if (normal.z > 0.0) normal = -normal; // towards the eye
            }
        }
    }
    imageStore(geo, t, vec4(normal, code));
    imageStore(shadowImg, t, vec4(0.0, 0.0, code, 0.0));
}

// On the quarter grid: the mean of 4x4 PS1 pixels, of the brightness (for the
// surroundings) and of the glow's source.
void quarter(ivec2 q) {
    float sum = 0.0, count = 0.0;
    vec3 source = vec3(0.0);
    for (int y = 0; y < 4; y++) for (int x = 0; x < 4; x++) {
        ivec2 t = q * 4 + ivec2(x, y);
        if (t.x >= pc.work.x || t.y >= pc.work.y) continue;
        sum += imageLoad(base, t).a;
        source += imageLoad(glow, t).rgb;
        count += 1.0;
    }
    count = max(count, 1.0);
    imageStore(quarterA, q, vec4(sum / count));
    imageStore(quarterGlow, q, vec4(source / count, 0.0));
}

// Across: the surroundings' brightness, and the glow's source at its two wide spreads.
void quarterAcross(ivec2 q) {
    ivec2 last = quarters() - 1;
    float sigma = SURROUND_SIGMA / 4.0;
    float sum = 0.0, total = 0.0;
    vec3 wide[2] = vec3[2](vec3(0.0), vec3(0.0));
    vec2 wideTotal = vec2(0.0);
    for (int d = -10; d <= 10; d++) {
        ivec2 s = clamp(q + ivec2(d, 0), ivec2(0), last);
        float g = exp(-float(d * d) / (2.0 * sigma * sigma));
        sum += imageLoad(quarterA, s).r * g;
        total += g;
        if (abs(d) <= 6) {
            vec3 c = imageLoad(quarterGlow, s).rgb;
            vec2 w = exp(-float(d * d) / (2.0 * GLOW_WIDE * GLOW_WIDE));
            if (abs(d) > 3) w.x = 0.0;
            wide[0] += c * w.x; wide[1] += c * w.y;
            wideTotal += w;
        }
    }
    imageStore(quarterB, q, vec4(sum / total));
    imageStore(quarterE, q, vec4(wide[0] / wideTotal.x, 0.0));
    imageStore(quarterPool, q, vec4(wide[1] / wideTotal.y, 0.0));
}

// Down: the same, and the two wide spreads by their shares into one image.
void quarterDown(ivec2 q) {
    ivec2 last = quarters() - 1;
    float sigma = SURROUND_SIGMA / 4.0;
    float sum = 0.0, total = 0.0;
    vec3 wide[2] = vec3[2](vec3(0.0), vec3(0.0));
    vec2 wideTotal = vec2(0.0);
    for (int d = -10; d <= 10; d++) {
        ivec2 s = clamp(q + ivec2(0, d), ivec2(0), last);
        float g = exp(-float(d * d) / (2.0 * sigma * sigma));
        sum += imageLoad(quarterB, s).r * g;
        total += g;
        if (abs(d) <= 6) {
            vec2 w = exp(-float(d * d) / (2.0 * GLOW_WIDE * GLOW_WIDE));
            if (abs(d) <= 3) wide[0] += imageLoad(quarterE, s).rgb * w.x; else w.x = 0.0;
            wide[1] += imageLoad(quarterPool, s).rgb * w.y;
            wideTotal += w;
        }
    }
    imageStore(quarterA, q, vec4(sum / total));
    imageStore(quarterWide, q, vec4(wide[0] / wideTotal.x * GLOW_SHARE.y + wide[1] / wideTotal.y * GLOW_SHARE.z, 0.0));
}

// What stands out as bright: scenery only, and not the distant backdrop.
void sources(ivec2 t) {
    vec4 b = imageLoad(base, t);
    float code = imageLoad(geo, t).a;
    vec3 e = vec3(0.0);
    if (code > 0.0) {
        float mean = textureLod(surround, quarterUv(vec2(t) + 0.5, surround), 0.0).r;
        float threshold = max(BOUNCE_RATIO * mean, BOUNCE_FLOOR);
        float peak = max(b.r, max(b.g, b.b));
        e = b.rgb * (clamp((peak - threshold) / threshold, 0.0, 1.0) * backdropFade(code));
    }
    imageStore(tempA, t, vec4(e, max(code, 0.0)));
}

// The normals softened along the surface (three PS1 pixels each way, only
// across scenery of nearly the same depth), so low-poly rock reads as rock.
void softNormals(ivec2 t, ivec2 axis, bool second) {
    vec4 own = second ? imageLoad(tempB, t) : imageLoad(geo, t);
    if (own.a <= 0.0) {
        if (second) imageStore(tempC, t, own);
        else imageStore(tempB, t, own);
        return;
    }
    vec3 sum = vec3(0.0);
    for (int d = -3; d <= 3; d++) {
        ivec2 s = t + axis * d;
        if (s.x < 0 || s.y < 0 || s.x >= pc.work.x || s.y >= pc.work.y) continue;
        vec4 v = second ? imageLoad(tempB, s) : imageLoad(geo, s);
        if (v.a <= 0.0) continue;
        sum += v.xyz * (exp(-float(d * d) / 4.5) * exp(-abs(v.a - own.a) / (0.012 * own.a)));
    }
    float len = length(sum);
    vec4 result = vec4(len > 1.0e-6 ? sum / len : own.xyz, own.a);
    if (second) imageStore(tempC, t, result);
    else imageStore(tempB, t, result);
}

// Top light from the softened normal; shade from the depth image around the
// PS1 pixel's centre, sampled in the copy so a near thing's small reach
// still finds its samples.
void topAndShade(ivec2 t) {
    vec4 soft = imageLoad(tempC, t);
    vec4 raw = imageLoad(geo, t);
    float code = raw.a;
    if (code <= 0.0) {
        imageStore(terms, t, vec4(0.0, 0.0, code, 0.0));
        return;
    }
    float fade = backdropFade(code);
    float top = clamp(TOP_RESPONSE * dot(soft.xyz, pc.view.xyz), -1.0, 1.0) * fade;
    float occlusion = 0.0;
    if (fade > 0.0 && (pc.strength.y > 0.0 || (pc.flags & (DEBUG | ALL)) != 0)) {
        ivec2 l = middle(t);
        vec3 p = place(middleAt(t), code);
        float reach = SHADE_REACH * pc.lens.z / pc.view.w;                              // view units
        float pixels = clamp(reach * pc.view.w / code, 1.0, 40.0) * float(pc.n);        // the copy's pixels, here
        float noise = turn(t);
        for (int d = 0; d < SHADE_DIRS; d++) {
            float angle = (float(d) + noise) * (6.2831853 / float(SHADE_DIRS));
            vec2 dir = vec2(cos(angle), sin(angle));
            for (int k = 0; k < SHADE_STEPS; k++) {
                float along = (float(k) + 0.5 + 0.5 * fract(noise * 7.0 + float(d) * 0.37)) / float(SHADE_STEPS);
                float sc;
                vec3 v = placeAt(l + ivec2(dir * pixels * along), sc) - p;
                if (sc <= 0.0) continue; // figures and empty pixels cast none
                float d2 = dot(v, v);
                float dist = sqrt(max(d2, 1.0e-6));
                occlusion += max(dot(raw.xyz, v) / dist - SHADE_BIAS, 0.0) * max(1.0 - d2 / (reach * reach), 0.0);
            }
        }
        occlusion *= fade / float(SHADE_DIRS * SHADE_STEPS);
    }
    imageStore(terms, t, vec4(top, occlusion, code, fade));
}

// The shade smoothed along surfaces: across scenery of nearly the same depth
// that faces the same way.
void shadeBlur(ivec2 t, ivec2 axis, bool second) {
    vec4 own = second ? imageLoad(tempB, t) : imageLoad(terms, t);
    if (own.b > 0.0) {
        vec3 normal = imageLoad(geo, t).xyz;
        float sum = 0.0, total = 0.0;
        for (int d = -2; d <= 2; d++) {
            ivec2 s = t + axis * d;
            if (s.x < 0 || s.y < 0 || s.x >= pc.work.x || s.y >= pc.work.y) continue;
            vec4 v = second ? imageLoad(tempB, s) : imageLoad(terms, s);
            if (v.b <= 0.0) continue;
            float facing = max(dot(imageLoad(geo, s).xyz, normal), 0.0);
            facing *= facing; facing *= facing; facing *= facing;
            float w = exp(-float(d * d) / 2.0) * exp(-abs(v.b - own.b) / (0.02 * own.b)) * facing;
            sum += v.g * w;
            total += w;
        }
        if (total > 0.0) own.g = sum / total;
    }
    if (second) imageStore(terms, t, own);
    else imageStore(tempB, t, own);
}

// The sources of 4x4 PS1 pixels as one: their light summed, at the depth
// their light is at on average.
void quarterSources(ivec2 q) {
    vec3 sum = vec3(0.0);
    float weight = 0.0, depthSum = 0.0;
    for (int y = 0; y < 4; y++) for (int x = 0; x < 4; x++) {
        ivec2 t = q * 4 + ivec2(x, y);
        if (t.x >= pc.work.x || t.y >= pc.work.y) continue;
        vec4 e = imageLoad(tempA, t);
        float w = e.r + e.g + e.b;
        sum += e.rgb;
        weight += w;
        depthSum += e.a * w;
    }
    imageStore(quarterE, q, vec4(sum, weight > 0.0 ? depthSum / weight : 0.0));
}

// The sources within reach of each quarter pixel, by distance in the scene
// and by how its surface faces them: every one of them, so nothing flickers.
// A figure has no surface: it takes a fixed share.
// Pass 11 per group: which quarter pixels round its own 8x8 hold a source,
// one bit each (BOUNCE_SCAN about it: everything a pixel of it can reach).
// The sources are few, so a pixel then visits only those, row by row and
// left to right: the same ones in the same order as a scan of every quarter
// pixel, so the sum is the same to the bit (and the reads far fewer).
const int GATHER_SPAN = 8 + 2 * BOUNCE_SCAN;
shared uint gatherBits[GATHER_SPAN][2];

void gatherMark(ivec2 base) {
    uint i = gl_LocalInvocationIndex;
    for (uint k = i; k < uint(GATHER_SPAN * 2); k += 64u) gatherBits[k / 2u][k % 2u] = 0u;
    barrier();
    ivec2 last = quarters() - 1;
    for (uint k = i; k < uint(GATHER_SPAN * GATHER_SPAN); k += 64u) {
        ivec2 c = ivec2(int(k % uint(GATHER_SPAN)), int(k / uint(GATHER_SPAN)));
        ivec2 s = base + c;
        if (s.x < 0 || s.y < 0 || s.x > last.x || s.y > last.y) continue;
        if (imageLoad(quarterE, s).a > 0.0) atomicOr(gatherBits[c.y][c.x >> 5], 1u << uint(c.x & 31));
    }
    barrier();
}

void gather(ivec2 q, ivec2 base) {
    ivec2 t = quarterMiddle(q);
    vec4 g = imageLoad(geo, t);
    float z = abs(g.a);
    vec3 sum = vec3(0.0);
    if (z > 0.0) {
        vec3 p = place(middleAt(t), z);
        float reach = BOUNCE_REACH * pc.lens.z / pc.view.w;       // view units
        float pixels = clamp(reach * pc.view.w / z, 2.0, 96.0);   // PS1 pixels, here
        float span = pixels / 4.0;                                // quarter pixels
        int scan = min(int(ceil(span)), BOUNCE_SCAN);
        float near = 8.0 * z / pc.view.w;                         // two quarter pixels here, in view units
        ivec2 at = q - base; // this pixel in the group's bits
        for (int y = -scan; y <= scan; y++) {
            int row = at.y + y;
            for (int word = 0; word < 2; word++) {
                // The row's bits from x = -scan to scan, in this word.
                int lo = clamp(at.x - scan - word * 32, 0, 32), hi = clamp(at.x + scan + 1 - word * 32, 0, 32);
                if (lo >= hi) continue;
                uint bits = gatherBits[row][word] & (hi - lo == 32 ? 0xFFFFFFFFu : ((1u << uint(hi - lo)) - 1u) << uint(lo));
                while (bits != 0u) {
                    int x = word * 32 + findLSB(bits) - at.x;
                    bits &= bits - 1u;
                    if (float(x * x + y * y) > span * span) continue;
                    ivec2 s = q + ivec2(x, y);
                    vec4 e = imageLoad(quarterE, s);
                    vec3 v = place(middleAt(quarterMiddle(s)), e.a) - p;
                    float d2 = dot(v, v);
                    float dist = sqrt(max(d2, 1.0e-6));
                    float facing = BOUNCE_FIGURE;
                    if (g.a > 0.0) {
                        // Closer than two quarter pixels the direction to a source means
                        // little (it may be this very spot): the fixed share there, the
                        // surface's facing beyond.
                        float lambert = clamp((dot(g.xyz, v) / dist + BOUNCE_WRAP) / (1.0 + BOUNCE_WRAP), 0.0, 1.0);
                        facing = mix(BOUNCE_FIGURE, lambert, clamp(dist / near, 0.0, 1.0));
                    }
                    float window = max(1.0 - d2 / (reach * reach), 0.0);
                    sum += e.rgb * (window * window * facing);
                }
            }
        }
        // The mean over the disc times its area in PS1 pixels, over pi: the
        // sum of the sources in it over pi.
        sum /= 3.14159265;
    }
    imageStore(quarterPool, q, vec4(sum, z));
}

// The glow's narrow spread across, then down with the wide spreads added.
void glowAcross(ivec2 t) {
    vec3 sum = vec3(0.0);
    float total = 0.0;
    for (int d = -4; d <= 4; d++) {
        float g = exp(-float(d * d) / (2.0 * GLOW_NARROW * GLOW_NARROW));
        sum += imageLoad(glow, inside(t + ivec2(d, 0))).rgb * g;
        total += g;
    }
    imageStore(tempA, t, vec4(sum / total, 0.0));
}

void glowDown(ivec2 t) {
    vec3 sum = vec3(0.0);
    float total = 0.0;
    for (int d = -4; d <= 4; d++) {
        float g = exp(-float(d * d) / (2.0 * GLOW_NARROW * GLOW_NARROW));
        sum += imageLoad(tempA, inside(t + ivec2(0, d))).rgb * g;
        total += g;
    }
    vec3 wide = textureLod(wideLayer, quarterUv(vec2(t) + 0.5, wideLayer), 0.0).rgb;
    imageStore(glow, t, vec4((sum / total * GLOW_SHARE.x + wide) * GLOW_GAIN, 0.0));
}

// The scenery's cast shadows: from each PS1 pixel's middle, steps toward the
// sun; a step that lands behind what the depth image holds there (by less
// than a thickness) is in shadow, darker the nearer the caster. Figures cast
// only through their silhouettes (below); everything drawn receives.
void shadowMarch(ivec2 t) {
    float code = imageLoad(geo, t).a;
    float occ = 0.0;
    int b = int(pc.lens.w);
    if (code != 0.0 && b >= 0) {
        float z = abs(code);
        vec3 sun = block[b].xyz;
        vec3 p = place(middleAt(t), z);
        float reach = SHADOW_REACH * pc.lens.z / pc.view.w; // view units
        float thick = SHADOW_THICK * reach;
        float noise = turn(t);
        // The nearest caster decides (the darkness falls with the step), so
        // the march stops at the first; and a march that has left the frame
        // never comes back into it (a straight line out of a rectangle).
        for (int i = 0; i < SHADOW_STEPS; i++) {
            vec3 q = p + sun * ((float(i) + 0.5 + noise) / float(SHADOW_STEPS) * reach);
            if (q.z <= 1.0) break;
            ivec2 l = ivec2((q.xy * pc.view.w / q.z + pc.lens.xy) * float(pc.n));
            if (l.x < 0 || l.y < 0 || l.x >= pc.size.x || l.y >= pc.size.y) break;
            float cq = depthCode(imageLoad(depth, l).r);
            if (cq > 0.0 && cq < q.z - 0.004 * q.z && q.z - cq < thick) {
                occ = sqrt(1.0 - float(i) / float(SHADOW_STEPS));
                break;
            }
        }
        occ *= backdropFade(z);
    }
    imageStore(shadowImg, t, vec4(occ, 0.0, code, 0.0));
}

// The characters' shadows: each figure pixel belongs to the actor whose ground
// point is nearest (across the screen and in depth) and below it; it is laid
// on the ground from there as if the sprite turned to face the sun: its
// offset across the sprite runs across the sun, its height along the sun's
// way, shortened by the sun's height. Darkest at the feet, fading toward the
// head's end, as under a soft light: by how far along the sun's way the ground
// pixel lies from the nearest foot, so every sprite pixel that lands on it
// writes the same value (whichever writes last, the picture is the same).
void silhouettes(ivec2 t) {
    int b = int(pc.lens.w);
    float code = imageLoad(geo, t).a;
    if (b < 0 || code >= 0.0) return;
    int count = min(int(block[b + 1].x), MAX_FIGURES);
    vec3 sun = block[b].xyz, up = pc.view.xyz;
    float rise = dot(sun, up);
    vec3 level = sun - rise * up;
    float run = length(level);
    if (count <= 0 || rise <= 0.05 || run < 1.0e-3) return;
    vec3 along = -level / run, across = cross(up, along);
    float cot = run / rise;
    vec3 cardX = normalize(vec3(1.0, 0.0, 0.0) - up.x * up); // the sprite's width, on the ground
    vec3 p = place(middleAt(t), -code);
    int best = -1;
    float bestScore = 1.0e9, bw = 0.0, bh = 0.0;
    for (int k = 0; k < count; k++) {
        vec3 f = block[b + 2 + k].xyz;
        if (f.z <= 1.0) continue;
        vec3 d = p - f;
        float scale = f.z / pc.view.w; // view units per PS1 pixel at the foot
        float h = dot(d, up), w = dot(d, cardX), dz = abs(p.z - f.z);
        if (h < -4.0 * scale || h > FIGURE_HEIGHT * scale || abs(w) > FIGURE_WIDTH * scale || dz > FIGURE_DEPTH * f.z) continue;
        float score = abs(w) / scale + dz / (0.01 * f.z);
        if (score < bestScore) { bestScore = score; best = k; bw = w; bh = max(h, 0.0); }
    }
    if (best < 0) return;
    vec3 s = block[b + 2 + best].xyz + bw * across + bh * cot * along;
    if (s.z <= 1.0) return;
    ivec2 g0 = ivec2(floor(s.xy * pc.view.w / s.z + pc.lens.xy - 0.5));
    for (int k = 0; k < 4; k++) {
        ivec2 g = g0 + ivec2(k & 1, k >> 1);
        if (g.x < 0 || g.y < 0 || g.x >= pc.work.x || g.y >= pc.work.y) continue;
        float rc = imageLoad(geo, g).a;
        // Only on what is drawn there at about the shadow's depth: the ground.
        if (rc <= 0.0 || abs(rc - s.z) > GROUND_DEPTH * s.z) continue;
        vec3 q = place(vec2(g) + 0.5, rc);
        int closest = 0;
        float nearest = 1.0e30;
        for (int j = 0; j < count; j++) {
            vec3 d = q - block[b + 2 + j].xyz;
            float apart = dot(d, d) - dot(d, up) * dot(d, up); // squared, on the ground
            if (block[b + 2 + j].z > 1.0 && apart < nearest) { nearest = apart; closest = j; }
        }
        vec3 f = block[b + 2 + closest].xyz;
        float way = max(dot(q - f, along), 0.0) / max(cot, 1.0e-3); // the height that lands here
        float fade = mix(1.0, FIGURE_FADE_TO, clamp(way / (FIGURE_FADE * f.z / pc.view.w), 0.0, 1.0));
        // The darker of this and the scenery's shadow there (pass 14), so a
        // faded end never lightens a wall's shadow it falls in.
        float was = imageLoad(shadowImg, g).r;
        imageStore(shadowImg, g, vec4(max(was, backdropFade(rc) * fade), 0.0, rc, 0.0));
    }
}

// The shadows smoothed along surfaces: across what is drawn at nearly the
// same depth (figures with figures, scenery with scenery).
void castBlur(ivec2 t, ivec2 axis, bool second) {
    vec4 own = second ? imageLoad(tempB, t) : imageLoad(shadowImg, t);
    if (own.b != 0.0) {
        float z = abs(own.b);
        float sum = 0.0, total = 0.0;
        for (int d = -2; d <= 2; d++) {
            ivec2 s = t + axis * d;
            if (s.x < 0 || s.y < 0 || s.x >= pc.work.x || s.y >= pc.work.y) continue;
            vec4 v = second ? imageLoad(tempB, s) : imageLoad(shadowImg, s);
            if (v.b == 0.0 || (v.b > 0.0) != (own.b > 0.0)) continue;
            float w = exp(-float(d * d) / 2.0) * exp(-abs(abs(v.b) - z) / (0.02 * z));
            sum += v.r * w;
            total += w;
        }
        if (total > 0.0) own.r = sum / total;
    }
    if (second) imageStore(shadowImg, t, own);
    else imageStore(tempB, t, own);
}

// The cast shadow at a point of the copy: filtered inside a surface, the four
// grid pixels one by one at an outline (as the top light and shade are read).
float castAt(vec2 at, vec2 uv, float code) {
    float z = abs(code);
    vec4 around = textureLod(castLayer, uv, 0.0);
    if (abs(around.b - code) <= 0.004 * z) return around.r;
    vec2 f = at - 0.5;
    ivec2 t0 = ivec2(floor(f));
    vec2 w = f - vec2(t0);
    float sum = 0.0, total = 0.0;
    for (int k = 0; k < 4; k++) {
        ivec2 o = ivec2(k & 1, k >> 1);
        vec4 v = imageLoad(shadowImg, inside(t0 + o));
        if (v.b == 0.0 || (v.b > 0.0) != (code > 0.0)) continue;
        float weight = (o.x == 1 ? w.x : 1.0 - w.x) * (o.y == 1 ? w.y : 1.0 - w.y);
        weight = (weight + 0.02) * exp(-abs(abs(v.b) - z) / (0.02 * z));
        sum += v.r * weight;
        total += weight;
    }
    return total > 1.0e-5 ? sum / total : 0.0;
}

// Brighter by a factor with a shoulder: black stays black, white stays white.
vec3 brighten(vec3 c, vec3 factor) {
    return c * factor / (1.0 + (factor - 1.0) * clamp(c, 0.0, 1.0));
}

// Pass 18, one group: the fog's colour, the mean shown colour of the scenery
// well past the focus (weighted from FOG_FAR_FROM to FOG_FAR_TO times the
// focus depth; sprites and kept pictures left out), or of all the scenery
// when too little is that far, taken half way to a neutral scaled by its
// brightness: a dark room gets a dim haze, a bright one a pale one.
shared vec4 fogFar[64], fogAll[64];
void fogColour() {
    uint i = gl_LocalInvocationIndex;
    vec4 far = vec4(0.0), every = vec4(0.0);
    for (int y = int(gl_LocalInvocationID.y); y < pc.work.y; y += 8)
        for (int x = int(gl_LocalInvocationID.x); x < pc.work.x; x += 8) {
            ivec2 t = ivec2(x, y);
            float code = imageLoad(geo, t).a;
            if (code <= 0.0) continue;
            vec3 shown = sqrt(max(imageLoad(base, t).rgb, 0.0));
            float w = smoothstep(FOG_FAR_FROM, FOG_FAR_TO, code / max(pc.lens.z, 1.0));
            far += vec4(shown * w, w);
            every += vec4(shown, 1.0);
        }
    fogFar[i] = far;
    fogAll[i] = every;
    barrier();
    for (uint s = 32u; s > 0u; s >>= 1) {
        if (i < s) { fogFar[i] += fogFar[i + s]; fogAll[i] += fogAll[i + s]; }
        barrier();
    }
    if (i == 0u && pc.lens.w >= 0.0) {
        vec4 f = fogFar[0], a = fogAll[0];
        vec3 mean = f.w > 0.02 * a.w && f.w > 0.0 ? f.rgb / f.w : a.w > 0.0 ? a.rgb / a.w : FOG_NEUTRAL;
        float grey = dot(mean, vec3(0.2126, 0.7152, 0.0722));
        // w: how bright the room's scenery is shown on the whole (the particles' place, xg-rgcf.5.10)
        vec3 every = a.w > 0.0 ? a.rgb / a.w : FOG_NEUTRAL;
        block[int(pc.lens.w) + FOG_SLOT] = vec4(0.5 * mean + 0.5 * FOG_NEUTRAL * clamp(grey * 1.6 + 0.2, 0.35, 1.0),
                                               dot(every, vec3(0.2126, 0.7152, 0.0722)));
    }
}

// Light shafts: the way light travels across the screen, from the room's sun
// (view space, toward the sun: x right, y down), down when the sun is
// straight ahead or behind.
vec2 shaftWay() {
    vec2 w = -block[int(pc.lens.w)].xy;
    float len = length(w);
    return len > 1.0e-3 ? w / len : vec2(0.0, 1.0);
}

// Pass 22, on the quarter grid: the shafts' sources, the shown colour of what
// is much brighter than the room, or of the far backdrop where it is not
// dark; not figures, nor where nothing or a kept picture is drawn.
void shaftSources(ivec2 q) {
    float grey = block[int(pc.lens.w) + FOG_SLOT].w;
    float lo = min(max(SHAFT_FLOOR, SHAFT_RATIO * grey), SHAFT_CEIL), hi = min(lo + SHAFT_SOFT, 1.0);
    vec3 sum = vec3(0.0);
    for (int y = 0; y < 4; y++) for (int x = 0; x < 4; x++) {
        ivec2 t = q * 4 + ivec2(x, y);
        if (t.x >= pc.work.x || t.y >= pc.work.y) continue;
        float code = imageLoad(geo, t).a;
        if (code <= 0.0) continue;
        vec3 shown = sqrt(max(imageLoad(base, t).rgb, 0.0));
        float lum = dot(shown, vec3(0.2126, 0.7152, 0.0722));
        float k = smoothstep(lo, hi, lum);
        float far = smoothstep(SHAFT_FAR_FROM, SHAFT_FAR_TO, 1.0 - pc.lens.z / code);
        sum += shown * max(k, far * smoothstep(0.35, 0.65, lum));
    }
    imageStore(quarterB, q, vec4(sum / 16.0, 0.0));
}

// The shafts' quarter images between their pixels (q's own at q), edges
// clamped: the sources (quarterB) and the gathered shafts (quarterE).
vec3 quarterAt(vec2 f) {
    ivec2 last = quarters() - 1;
    f = clamp(f, vec2(0.0), vec2(last));
    ivec2 i = min(ivec2(floor(f)), last);
    vec2 w = f - vec2(i);
    ivec2 j = min(i + 1, last);
    return mix(mix(imageLoad(quarterB, i).rgb, imageLoad(quarterB, ivec2(j.x, i.y)).rgb, w.x),
               mix(imageLoad(quarterB, ivec2(i.x, j.y)).rgb, imageLoad(quarterB, j).rgb, w.x), w.y);
}
vec3 quarterAtE(vec2 f) {
    ivec2 last = quarters() - 1;
    f = clamp(f, vec2(0.0), vec2(last));
    ivec2 i = min(ivec2(floor(f)), last);
    vec2 w = f - vec2(i);
    ivec2 j = min(i + 1, last);
    return mix(mix(imageLoad(quarterE, i).rgb, imageLoad(quarterE, ivec2(j.x, i.y)).rgb, w.x),
               mix(imageLoad(quarterE, ivec2(i.x, j.y)).rgb, imageLoad(quarterE, j).rgb, w.x), w.y);
}

// Pass 23, on the quarter grid: each quarter pixel gathers the sources back
// toward the sun, fading with the distance: the light they spill along its way.
void shaftGather(ivec2 q) {
    vec2 back = -shaftWay();
    vec3 sum = vec3(0.0);
    float total = 0.0;
    for (int k = 1; k <= SHAFT_STEPS; k++) {
        vec2 f = vec2(q) + back * float(k);
        float w = exp(-SHAFT_FADE * float(k) / float(SHAFT_STEPS));
        // Outside the frame: nothing (the light comes only from what is shown).
        if (all(greaterThanEqual(f, vec2(0.0))) && all(lessThanEqual(f, vec2(quarters() - 1)))) sum += w * quarterAt(f);
        total += w;
    }
    imageStore(quarterE, q, vec4(sum / total, 0.0));
}

// Bands across the shafts' way: three waves of the place across it (PS1
// pixels), with fixed phases, drifting slowly with the time.
float shaftBands(float across, vec3 periods, vec3 shares, float phase) {
    vec3 w = 0.5 + 0.5 * sin(across / periods * 6.2831853 + vec3(phase, phase * 1.7 + 2.1, phase * 2.9 + 4.4));
    return dot(w, shares);
}

// The light the shafts add at a point of the frame (PS1 pixels of the layers).
vec3 shaftLight(vec2 at, uint raw, int b) {
    vec4 s = block[b + SHAFT_SLOT];
    vec2 way = shaftWay();
    float across = at.x * way.y - at.y * way.x;
    // The beams: the gathered sources (quarter pixel q's value belongs at PS1 pixel 4q + 2.5), banded.
    vec3 beams = quarterAtE((at - 2.5) / 4.0);
    float streak = 0.35 + 1.3 * shaftBands(across + 1.5 * s.y, vec3(23.0, 9.0, 4.0), vec3(0.55, 0.3, 0.15), 1.3);
    vec3 light = SHAFT_BEAMS * beams * streak;
    // The sunbeams: over what is drawn, strongest at the top of the frame.
    if (raw != DEPTH_FAR) {
        float band = smoothstep(0.35, 0.9, shaftBands(across + 0.8 * s.y, vec3(61.0, 27.0, 11.0), vec3(0.5, 0.3, 0.2), 0.4));
        light += SHAFT_SUN * band * exp(-at.y / (SHAFT_REACH * float(pc.work.y))) * SUN_COLOUR;
    }
    return s.x * light;
}

// The warm and cool grade on a shown colour, by amount k (1: the agreed
// look): shadows toward cool, highlights toward warm, a touch more colour
// and contrast.
vec3 grade(vec3 c, float k) {
    float l = dot(c, vec3(0.2126, 0.7152, 0.0722));
    float low = clamp(1.0 - l / 0.35, 0.0, 1.0), high = clamp((l - 0.55) / 0.45, 0.0, 1.0);
    vec3 o = c * (1.0 + k * low * (vec3(0.93, 0.98, 1.07) - 1.0)) * (1.0 + k * high * (vec3(1.06, 1.0, 0.91) - 1.0));
    o = l + (o - l) * (1.0 + 0.12 * k);
    o = 0.5 + (o - 0.5) * (1.0 + 0.06 * k);
    return clamp(o, 0.0, 1.0);
}

void composite(ivec2 l) {
    ivec2 p = pc.origin + l;
    uint word = imageLoad(color, p).r;
    uint raw = imageLoad(depth, l).r;
    float code = depthCode(raw);
    vec3 c = light(word);
    // This pixel's place on the PS1 grid, kept inside the part of the layers
    // this frame made (the images may be larger).
    vec2 at = (vec2(l) + 0.5) / float(pc.n) + vec2(pc.layer);
    vec2 uv = clamp(at, vec2(0.5), vec2(pc.work) - 0.5) / vec2(textureSize(glowLayer, 0));

    bool all = (pc.flags & (DEBUG | ALL)) != 0;
    bool surface = code > 0.0 && (all || pc.strength.x > 0.0 || pc.strength.y > 0.0);
    float top = 0.0, shade = 0.0;
    vec4 smooth4 = surface ? textureLod(termsLayer, uv, 0.0) : vec4(0.0);
    if (surface && abs(smooth4.b - code) <= 0.004 * code) {
        // Inside a surface: the four PS1 pixels around are on it too.
        top = smooth4.r;
        shade = smooth4.g;
    } else if (surface) {
        // At an outline: the four one by one, by closeness on the screen and in depth.
        vec2 f = at - 0.5;
        ivec2 t0 = ivec2(floor(f));
        vec2 w = f - vec2(t0);
        float total = 0.0;
        for (int k = 0; k < 4; k++) {
            ivec2 o = ivec2(k & 1, k >> 1);
            vec4 v = imageLoad(terms, inside(t0 + o));
            if (v.b <= 0.0) continue;
            float weight = (o.x == 1 ? w.x : 1.0 - w.x) * (o.y == 1 ? w.y : 1.0 - w.y);
            weight = (weight + 0.02) * exp(-abs(v.b - code) / (0.02 * code));
            top += v.r * weight;
            shade += v.g * weight;
            total += weight;
        }
        if (total > 1.0e-5) { top /= total; shade /= total; } else { top = 0.0; shade = 0.0; }
    }
    vec3 pool = vec3(0.0);
    if (code != 0.0 && (all || pc.strength.z > 0.0)) {
        float z = abs(code);
        vec4 around = textureLod(poolLayer, quarterUv(at, poolLayer), 0.0);
        if (abs(around.a - z) <= 0.01 * z) {
            pool = around.rgb;
        } else {
            // At an outline: the four quarter pixels one by one.
            vec2 f = (at - 0.5) / 4.0 - 0.5;
            ivec2 q0 = ivec2(floor(f));
            vec2 w = f - vec2(q0);
            float total = 0.0;
            for (int k = 0; k < 4; k++) {
                ivec2 o = ivec2(k & 1, k >> 1);
                vec4 v = imageLoad(quarterPool, clamp(q0 + o, ivec2(0), quarters() - 1));
                if (v.a <= 0.0) continue;
                float weight = (o.x == 1 ? w.x : 1.0 - w.x) * (o.y == 1 ? w.y : 1.0 - w.y);
                weight = (weight + 0.02) * exp(-abs(v.a - z) / (0.05 * z));
                pool += v.rgb * weight;
                total += weight;
            }
            pool = total > 1.0e-5 ? pool / total : vec3(0.0);
        }
        pool *= BOUNCE_GAIN;
    }
    vec3 halo = all || pc.strength.w > 0.0 ? textureLod(glowLayer, uv, 0.0).rgb : vec3(0.0);
    int b = int(pc.lens.w);
    float dark = b >= 0 ? block[b].w : 0.0;
    float shadow = code != 0.0 && b >= 0 && (all || dark > 0.0) ? castAt(at, uv, code) : 0.0;

    if ((pc.flags & DEBUG) != 0) {
        // Red: shade and cast shadows; green: top light around a middle; blue: glow and bounce.
        vec3 shown = vec3(clamp(max(shade * SHADE_GAIN, shadow), 0.0, 1.0), 0.5 + 0.5 * top,
                          clamp(dot(halo + pool, vec3(0.3333)), 0.0, 1.0));
        uvec3 o = uvec3(clamp(shown, 0.0, 1.0) * 255.0 + 0.5);
        imageStore(color, p, uvec4((word & 0xFF000000u) | o.r | o.g << 8 | o.b << 16));
        return;
    }

    if (code > 0.0 && pc.strength.x > 0.0) {
        float f = 1.0 + pc.strength.x * (top > 0.0 ? TOP_UP : TOP_DOWN) * top;
        f *= f;
        c = f > 1.0 ? brighten(c, vec3(f)) : c * f;
    }
    if (pc.strength.z > 0.0) c = brighten(c, 1.0 + pc.strength.z * pool);
    if (code > 0.0 && pc.strength.y > 0.0) {
        float s = 1.0 - clamp(pc.strength.y * SHADE_GAIN * shade, 0.0, SHADE_MOST);
        c *= s * s;
    }
    if (dark > 0.0 && shadow > 0.0) {
        // A painted light (a window, a lamp, a fire) stays as bright as it is painted.
        float own = max(c.r, max(c.g, c.b));
        float s = 1.0 - clamp(dark * shadow * (1.0 - smoothstep(SHADOW_KEEP_FROM, SHADOW_KEEP_TO, own)), 0.0, SHADOW_MOST);
        c *= s * s;
    }
    if (pc.strength.w > 0.0) c += pc.strength.w * halo * (1.0 - clamp(c, 0.0, 1.0)); // never past white
    vec3 shown = clamp(sqrt(max(c, 0.0)), 0.0, 1.0);
    // Fog: thicker past the focus, never more than atmos.x; sprites by where
    // they stand, nothing on a kept picture or where nothing was drawn.
    if (pc.atmos.x > 0.0 && b >= 0 && raw != DEPTH_SHARP && raw != DEPTH_FAR) {
        float past = max(float(raw & ~DEPTH_FIGURE) / 16.0 / max(pc.lens.z, 1.0) - 1.0, 0.0);
        if (pc.atmos.w > 0.0) past = min(past, pc.atmos.w);
        shown = mix(shown, block[b + FOG_SLOT].rgb, pc.atmos.x * (1.0 - exp(-pc.atmos.y * past)));
    }
    if (pc.atmos.z > 0.0) shown = grade(shown, pc.atmos.z);
    if (b >= 0 && block[b + SHAFT_SLOT].x > 0.0) shown = 1.0 - (1.0 - shown) * (1.0 - clamp(shaftLight(at, raw, b), 0.0, 1.0));
    if (pc.vignette > 0) {
        // The vignette: the edges darker by a smooth falloff from the frame's
        // middle (an ellipse, its aspect kept), from 0.45 of the way to the
        // corners; the frame is the one the layers were made from.
        vec2 off = at / vec2(pc.work) * 2.0 - 1.0;
        float far = clamp((length(off) / sqrt(2.0) - VIGNETTE_FROM) / (1.0 - VIGNETTE_FROM), 0.0, 1.0);
        shown *= 1.0 - float(pc.vignette) / 4096.0 * far * far * (3.0 - 2.0 * far);
    }
    uvec3 o = uvec3(shown * 255.0 + 0.5);
    uint packed = o.r | o.g << 8 | o.b << 16;
    // A pixel nothing changed is not written: it stays bit for bit what was drawn.
    if (packed == (word & 0xFFFFFFu)) return;
    o = sceneColorMode(o, p, pc.n, pc.color, pc.ditherOrigin);
    imageStore(color, p, uvec4((word & 0xFF000000u) | o.r | o.g << 8 | o.b << 16));
}

// Ambient particles (xg-rgcf.5.10), after the blur: dust where the place is
// lit, embers where it is dark (how bright the room is on the whole: the fog
// pass's w). Each keeps its place in the room, in a cell of a grid fixed to
// the room (only cells the frame can see hold any), so a turning camera sees
// each one move exactly as the scenery at its depth (xg-dkkh); it drifts by
// the frame's time, around its cell: dust
// rises and wavers, embers wander. Pass 20 places each one (its record), as
// blurred as the depth of field would make it at its depth, and marks the
// tiles it may cover (particleTiles; 2048 bits a tile; atomicOr: the same bits whatever the
// order); pass 21 adds to each pixel of the copy the particles of its tile in
// their order, those nearer than what is drawn there. Nothing over a pixel
// where nothing or a kept picture is drawn.
const int PARTICLES_MAX = 2048, PARTICLE_EMBERS = 1536; // embers from this index on
const int PART_SLOT = 4 + MAX_FIGURES;                // after the fog's colour (vk.c LIGHT_BLOCK_BYTES)
const int PART_REC = PART_SLOT + 5, PART_MASK = PART_REC + 3 * PARTICLES_MAX;
const int PARTICLE_TILES = 64 * 16; // the masks' room (vk.c PARTICLE_TILES)

// The tiles over the frame: 16 PS1 pixels a side, twice that while the frame
// would take more than the masks' room (a large world map frame).
ivec3 particleTiles() {
    int side = 16;
    ivec2 n = (pc.work + side - 1) / side;
    while (n.x * n.y > PARTICLE_TILES) {
        side *= 2;
        n = (pc.work + side - 1) / side;
    }
    return ivec3(n, side);
}
const vec3 DUST_COLOUR = vec3(1.0, 0.95, 0.86), EMBER_COLOUR = vec3(1.0, 0.72, 0.35);

uint particleHash(uint x) {
    x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16;
    return x;
}
float particleRandom(uint i, uint k) { return float(particleHash(i * 16u + k) >> 8) / 16777216.0; }

// A cell's number for its hash: the same cell, the same number, wherever the camera is.
uint particleCell(ivec3 c, uint salt) {
    return particleHash(uint(c.x) * 73856093u ^ uint(c.y) * 19349663u ^ uint(c.z) * 83492791u ^ salt);
}

void particleRecord(int i) {
    int b = int(pc.lens.w);
    int rec = b + PART_REC + 3 * i;
    vec4 setting = block[b + PART_SLOT + 3]; // the box, the time (s), the size, the level
    vec4 lens = block[b + PART_SLOT + 4];    // the depth of field's band, gain, radius (PS1 pixels); w: the tilt-shift's
    int level = int(setting.w);
    bool ember = i >= PARTICLE_EMBERS;
    int k = ember ? i - PARTICLE_EMBERS : i;
    // The densities: so many in a box shaped to the view (a tenth wider than
    // the frame at the farthest depth they take, depths 0.35 to 1.6 of the
    // room's first focus), as the design had them.
    int count = ember ? (level == 1 ? 40 : level == 2 ? 70 : 110) : (level == 1 ? 500 : level == 2 ? 900 : 1400);
    block[rec + 1] = vec4(0.0);
    if (level <= 0 || k >= 2 * count) return; // the frame holds well under twice the box's
    float focus = pc.lens.z, box = setting.x, time = setting.y;
    float focus0 = box / 2.5;          // the focus the room started with
    float unit = focus0 / pc.view.w;   // a PS1 pixel at that focus, in view units
    vec3 span = vec3(1.1 * 1.6 * focus0 * vec2(pc.work) / pc.view.w, 1.25 * focus0);
    float grey = block[b + FOG_SLOT].w; // how bright the room is shown
    float weight = ember ? 1.0 - smoothstep(0.10, 0.24, grey) : smoothstep(0.08, 0.22, grey);
    if (weight <= 0.0) return;

    vec3 r0 = block[b + PART_SLOT].xyz, r1 = block[b + PART_SLOT + 1].xyz, r2 = block[b + PART_SLOT + 2].xyz;
    vec3 trans = vec3(block[b + PART_SLOT].w, block[b + PART_SLOT + 1].w, block[b + PART_SLOT + 2].w);
    mat3 toRoom = mat3(r0, r1, r2); // its columns are the view's rows: the transpose
    mat3 toView = transpose(toRoom);

    // Each lives in a cell of a grid fixed to the room (a quarter of the first
    // focus a side), so as the camera turns or moves it keeps its place and
    // moves on the frame exactly as the scenery at its depth. (Folded into a
    // box in the view's frame instead, a far place moved with a turning camera
    // by its true distance, drawn near: they raced across the frame, xg-dkkh.)
    // A cell holds the design's density, the last of its share present in
    // some cells by the cell's hash, and only cells the frame can see (with a
    // cell's half-diagonal to spare: depths 0.35 to 1.6, the frame's sides)
    // take a share of the budget: this one finds its cell by walking them in
    // order. Each drifts inside its cell and comes back at its other side.
    float cell = 0.25 * focus0, spare = 0.87 * cell;
    // 0.57: the frame's density the design was tuned at (the view-shaped box
    // kept over 40% of its share out of the frame: measured, xg-dkkh).
    float perCell = 0.57 * float(count) * cell * cell * cell / (span.x * span.y * span.z);
    float near = 0.35 * focus0, far = 1.6 * focus0;
    vec2 sideLo = -pc.lens.xy / pc.view.w, sideHi = (vec2(pc.work) - pc.lens.xy) / pc.view.w; // the frame's sides per depth
    vec3 rmin = vec3(1.0e30), rmax = vec3(-1.0e30);
    for (int c = 0; c < 8; c++) {
        float z = (c & 1) != 0 ? far : near;
        vec2 xy = vec2((c & 2) != 0 ? sideHi.x : sideLo.x, (c & 4) != 0 ? sideHi.y : sideLo.y) * z;
        vec3 corner = toRoom * (vec3(xy, z) - trans);
        rmin = min(rmin, corner);
        rmax = max(rmax, corner);
    }
    ivec3 c0 = ivec3(floor((rmin - spare) / cell)), c1 = ivec3(floor((rmax + spare) / cell));
    uint salt = ember ? 0x9E3779B9u : 0x85EBCA6Bu;
    int seen = 0, slot = -1;
    ivec3 home = ivec3(0);
    for (int z = c0.z; z <= c1.z && slot < 0; z++)
        for (int y = c0.y; y <= c1.y && slot < 0; y++)
            for (int x = c0.x; x <= c1.x && slot < 0; x++) {
                ivec3 cc = ivec3(x, y, z);
                vec3 vc = toView * ((vec3(cc) + 0.5) * cell) + trans;
                if (vc.z < near - spare || vc.z > far + spare) continue;
                if (vc.x < sideLo.x * vc.z - spare || vc.x > sideHi.x * vc.z + spare ||
                    vc.y < sideLo.y * vc.z - spare || vc.y > sideHi.y * vc.z + spare) continue;
                int n = int(perCell) + (float(particleCell(cc, salt) >> 8) / 16777216.0 < fract(perCell) ? 1 : 0);
                if (k < seen + n) {
                    home = cc;
                    slot = k - seen;
                }
                seen += n;
            }
    if (slot < 0) return;

    vec3 up = toRoom * pc.view.xyz, right = toRoom * vec3(1.0, 0.0, 0.0), ahead = toRoom * vec3(0.0, 0.0, 1.0);
    uint id = particleCell(home, salt ^ (uint(slot + 1) * 0x27D4EB2Du)); // this one's own numbers
    vec3 at0 = vec3(particleRandom(id, 0u), particleRandom(id, 1u), particleRandom(id, 2u));
    vec3 ph = 6.2831853 * vec3(particleRandom(id, 3u), particleRandom(id, 4u), particleRandom(id, 5u));
    float sp = 0.6 + 0.8 * particleRandom(id, 6u);
    vec3 drift = ember ? right * (5.0 * sin(0.9 * time * sp + ph.x) + sin(2.3 * time + ph.z)) +
                         up * (4.0 * sin(0.6 * time * sp + ph.y) + 0.8 * time) + ahead * (3.0 * sin(0.3 * time + ph.z))
                       : right * (3.0 * sin(0.7 * time * sp + ph.x)) + up * (2.2 * time * sp + 1.5 * sin(0.5 * time + ph.y)) +
                         ahead * (2.0 * sin(0.4 * time * sp + ph.z));
    vec3 placed = (vec3(home) + fract(at0 + drift * unit / cell)) * cell;
    vec3 v = toView * placed + trans;
    if (v.z < 0.3 * focus0) return;
    vec2 at = v.xy * pc.view.w / v.z + pc.lens.xy;
    if (any(isnan(at)) || any(isinf(at))) return;
    float size = (ember ? 1.0 : 0.9) * setting.z * unit * pc.view.w / v.z; // PS1 pixels
    float u = v.z > focus ? 1.0 - focus / v.z : v.z / focus - 1.0;
    float coc = lens.z > 0.0 ? clamp((abs(u) - lens.x) * lens.y, 0.0, lens.z) : 0.0;
    float radius = max(size, coc);
    float gain = level == 1 ? 0.7 : level == 2 ? 0.9 : 1.1;
    // In the tilt-shift's strips a mote fades as their blur would dim it,
    // keeping its own footprint (the blur's would bin it into many more tiles).
    float dim = 1.0;
    if (lens.w > 0.0) {
        int packed = int(lens.w);
        float most = float(packed >> 10) / 16.0;
        dim = radius / max(radius, most * tiltRamp(at, vec2(float(pc.work.x), float(pc.work.y - (packed & 1023)))));
    }
    vec3 colour;
    float alpha, glow = 0.0;
    if (!ember) {
        // Dust shows in the light: the surroundings' brightness here (half as
        // it is, half against the room's), and lit scenery close behind it, not
        // the sky or the backdrop.
        if (at.x < 0.0 || at.y < 0.0 || at.x >= float(pc.work.x) || at.y >= float(pc.work.y)) return;
        ivec2 g = ivec2(at);
        float behind = abs(imageLoad(geo, g).a);
        if (behind <= 0.0) return;
        float lum = sqrt(max(textureLod(surround, quarterUv(at, surround), 0.0).r, 0.0));
        float lit = pow(clamp((0.5 * lum / 0.45 + 0.5 * lum / max(1.6 * grey, 0.08) - 0.25) / 0.6, 0.0, 1.0), 1.3);
        lit *= clamp((2.0 * focus - behind) / (0.6 * focus), 0.0, 1.0);
        vec3 tint = sqrt(max(imageLoad(base, g).rgb, 0.0));
        colour = 0.7 * DUST_COLOUR + 0.3 * tint / max(max(tint.r, max(tint.g, tint.b)), 1.0e-3);
        alpha = gain * weight * lit * (size / radius) * dim * (1.0 + 0.3 * sin(3.0 * time + ph.z));
    } else {
        colour = EMBER_COLOUR;
        glow = max(radius * 2.2, 2.0 / float(pc.n));
        alpha = gain * weight * pow(size / radius * dim, 0.8) * (0.6 + 0.4 * pow(sin(1.7 * time * sp + ph.x), 2.0));
    }
    if (alpha < 1.0 / 512.0) return;
    block[rec] = vec4(at, v.z, radius);
    block[rec + 1] = vec4(colour, alpha);
    block[rec + 2] = vec4(glow, 0.35, 0.0, 0.0);
    float reach = ember ? 3.0 * glow : 2.0 * radius + 1.0;
    ivec3 grid = particleTiles();
    ivec2 tiles = grid.xy;
    float side = float(grid.z);
    ivec2 lo = clamp(ivec2(floor(clamp(at - reach, vec2(-1.0), vec2(pc.work)) / side)), ivec2(0), tiles - 1);
    ivec2 hi = clamp(ivec2(floor(clamp(at + reach, vec2(-1.0), vec2(pc.work)) / side)), ivec2(0), tiles - 1);
    uint words0 = uint(b + PART_MASK) * 4u + uint(i >> 5);
    for (int ty = lo.y; ty <= hi.y; ty++)
        for (int tx = lo.x; tx <= hi.x; tx++)
            atomicOr(words[words0 + uint(ty * tiles.x + tx) * uint(PARTICLES_MAX / 32)], 1u << uint(i & 31));
}

void particlesDraw(ivec2 l) {
    uint raw = imageLoad(depth, l).r;
    if (raw == DEPTH_FAR || raw == DEPTH_SHARP) return;
    float z = abs(depthCode(raw));
    int b = int(pc.lens.w);
    vec2 at = (vec2(l) + 0.5) / float(pc.n) + vec2(pc.layer);
    ivec3 grid = particleTiles();
    ivec2 tiles = grid.xy;
    ivec2 tile = clamp(ivec2(floor(at / float(grid.z))), ivec2(0), tiles - 1);
    uint words0 = uint(b + PART_MASK) * 4u + uint(tile.y * tiles.x + tile.x) * uint(PARTICLES_MAX / 32);
    float least = 0.6 / float(pc.n);
    vec3 add = vec3(0.0);
    for (int w = 0; w < PARTICLES_MAX / 32; w++) {
        uint m = words[words0 + uint(w)];
        while (m != 0u) {
            int i = w * 32 + findLSB(m);
            m &= m - 1u;
            vec4 place = block[b + PART_REC + 3 * i];
            if (place.z >= z) continue; // behind what is drawn here
            vec4 colour = block[b + PART_REC + 3 * i + 1];
            vec4 glow = block[b + PART_REC + 3 * i + 2];
            vec2 d = at - place.xy;
            float dd = dot(d, d), sigma = max(place.w * 0.6, least);
            float s = exp(-0.5 * dd / (sigma * sigma));
            if (glow.x > 0.0) s += glow.y * exp(-0.5 * dd / (glow.x * glow.x));
            add += s * colour.a * colour.rgb;
        }
    }
    if (all(lessThan(add, vec3(0.5 / 255.0)))) return;
    ivec2 p = pc.origin + l;
    uint word = imageLoad(color, p).r;
    vec3 shown = vec3(float(word & 255u), float((word >> 8) & 255u), float((word >> 16) & 255u)) / 255.0;
    shown = clamp(shown + add * (1.0 - 0.5 * shown), 0.0, 1.0);
    uvec3 o = uvec3(shown * 255.0 + 0.5);
    uint packed = o.r | o.g << 8 | o.b << 16;
    if (packed == (word & 0xFFFFFFu)) return;
    o = sceneColorMode(o, p, pc.n, pc.color, pc.ditherOrigin);
    imageStore(color, p, uvec4((word & 0xFF000000u) | o.r | o.g << 8 | o.b << 16));
}

void main() {
    ivec2 t = ivec2(gl_GlobalInvocationID.xy);
    if (pc.pass == 20) {
        int i = int(gl_WorkGroupID.x) * 64 + int(gl_LocalInvocationIndex); // groups of 8x8: 64 particles each
        if (i < PARTICLES_MAX) particleRecord(i);
        return;
    }
    if (pc.pass == 21) {
        if (t.x < pc.size.x && t.y < pc.size.y) particlesDraw(t);
        return;
    }
    if (pc.pass == 11) {
        // Every invocation of the group marks the sources (barriers), then
        // those on the grid gather.
        ivec2 base = ivec2(gl_WorkGroupID.xy) * 8 - BOUNCE_SCAN;
        gatherMark(base);
        ivec2 q = quarters();
        if (t.x < q.x && t.y < q.y) gather(t, base);
        return;
    }
    if (pc.pass == 19) {
        if (t.x < pc.size.x && t.y < pc.size.y) composite(t);
        return;
    }
    if (pc.pass == 18) {
        fogColour();
        return;
    }
    if ((pc.pass >= 1 && pc.pass <= 3) || pc.pass == 10 || pc.pass == 11 || pc.pass == 22 || pc.pass == 23) {
        ivec2 q = quarters();
        if (t.x >= q.x || t.y >= q.y) return;
        switch (pc.pass) {
        case 1: quarter(t); break;
        case 2: quarterAcross(t); break;
        case 3: quarterDown(t); break;
        case 22: shaftSources(t); break;
        case 23: shaftGather(t); break;
        default: quarterSources(t); break;
        }
        return;
    }
    if (t.x >= pc.work.x || t.y >= pc.work.y) return;
    switch (pc.pass) {
    case 0: prepare(t); break;
    case 4: sources(t); break;
    case 5: softNormals(t, ivec2(1, 0), false); break;
    case 6: softNormals(t, ivec2(0, 1), true); break;
    case 7: topAndShade(t); break;
    case 8: shadeBlur(t, ivec2(1, 0), false); break;
    case 9: shadeBlur(t, ivec2(0, 1), true); break;
    case 12: glowAcross(t); break;
    case 13: glowDown(t); break;
    case 14: shadowMarch(t); break;
    case 15: silhouettes(t); break;
    case 16: castBlur(t, ivec2(1, 0), false); break;
    default: castBlur(t, ivec2(0, 1), true); break;
    }
}
