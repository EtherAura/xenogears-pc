#version 450

// Scene lighting over one frame of the hi-res copy (port/src/gpu/scene.c,
// vk.c sceneLightRecord; docs/PORT_HD2D.md sections 14, 15). It runs where
// the depth of field does, before it: after the scene's last packet, before
// the first packet of the UI. Written from the textbook pieces named below
// and our own prototype (work/hd2d/light); no other project's code.
//
// Inputs: the copy's frame (8:8:8 colour in bits 0-23; the mask and coverage
// bits above pass through) and the scene's depth image (hires.frag DEPTH:
// view depth in 1/16 units, bit 30 set for a figure (a sprite), 0 a picture
// kept as it is, all ones nothing drawn).
//
// The rooms give no light to work with (694 of 730 field headers hold none,
// and the scenery is pre-lit), so all four parts come from the picture and
// its depth:
//   top light  scenery that faces up gets brighter, scenery that faces down
//              darker, upright surfaces stay as they are: the light is
//              overhead, where the blob shadow under every character says
//              it is. The surface normal is the cross product of a pixel's
//              neighbours in view space, softened along the surface;
//   shade      how much nearby scenery fills the half-space above a pixel
//              (the usual screen-space occlusion estimate): creases, corners
//              and the ground under an overhang;
//   bounce     a pixel that stands out as bright against its surroundings is
//              a small light at its own place in the scene, and lights what
//              is near it by distance and facing;
//   glow       light above a high threshold, spread softly.
// Figures (sprites) get no top light and no shade, cast neither, and are no
// source of bounce or glow; bounce and glow fall on them. A distant backdrop
// (far behind the focus, by the depth of field's measure) is a painting:
// neither lit, shaded nor a source.
//
// Everything but the last pass is made on the PS1's own pixel grid or on a
// quarter of it, in PS1 pixels and view units, so the look does not depend
// on N:
//   0      prepare: the mean light of each PS1 pixel, its glow source, and
//          the normal and depth at its centre;
//   1-3    on the quarter grid: the mean brightness of the surroundings, and
//          the glow's two wide spreads;
//   4      the bounce sources;
//   5, 6   the normals softened across and down;
//   7      top light and shade;
//   8, 9   the shade smoothed along surfaces;
//   10, 11 on the quarter grid: the sources summed, then gathered by each
//          quarter pixel within its reach (every one of them: no noise);
//   12, 13 the glow's narrow spread, and the wide ones added;
//   14     composite at the copy's resolution. Top light, shade and bounce
//          are read from the grid pixels around: filtered where those lie on
//          the pixel's own surface (their filtered depth is the pixel's),
//          else one by one, weighted by how close their depth is to the
//          pixel's, so they stop at an object's outline. The same passes'
//          results serve both copies of a frame drawn wide (the copy of VRAM
//          reads them at `layer`).
// Colours are worked on as light (the squared 8-bit value).

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, r32ui) uniform uimage2D color;
layout(set = 0, binding = 1, r32ui) uniform readonly uimage2D depth;
layout(set = 0, binding = 2, rgba16f) uniform image2D base;    // rgb: mean light, a: its brightness
layout(set = 0, binding = 3, rgba16f) uniform image2D glow;    // the glow's source, then the glow
layout(set = 0, binding = 4, rgba16f) uniform image2D geo;     // xyz: normal (view space), a: depth code
layout(set = 0, binding = 5, rgba16f) uniform image2D tempA;
layout(set = 0, binding = 6, rgba16f) uniform image2D tempB;
layout(set = 0, binding = 7, rgba16f) uniform image2D tempC;
layout(set = 0, binding = 8, rgba16f) uniform image2D terms;   // r: top light, g: shade, b: depth code, a: backdrop fade
// The quarter grid.
layout(set = 0, binding = 9, rgba16f) uniform image2D quarterA;     // the surroundings' brightness
layout(set = 0, binding = 10, rgba16f) uniform image2D quarterB;
layout(set = 0, binding = 11, rgba16f) uniform image2D quarterE;    // rgb: the sources summed, a: their depth
layout(set = 0, binding = 12, rgba16f) uniform image2D quarterPool; // rgb: the bounce light, a: the depth it was gathered at
layout(set = 0, binding = 13, rgba16f) uniform image2D quarterGlow; // the glow's source
layout(set = 0, binding = 14, rgba16f) uniform image2D quarterWide; // the glow's wide spreads
// Read with bilinear filtering.
layout(set = 0, binding = 15) uniform sampler2D surround;    // quarterA
layout(set = 0, binding = 16) uniform sampler2D poolLayer;   // quarterPool
layout(set = 0, binding = 17) uniform sampler2D glowLayer;   // glow
layout(set = 0, binding = 18) uniform sampler2D termsLayer;  // terms
layout(set = 0, binding = 19) uniform sampler2D wideLayer;   // quarterWide

layout(push_constant) uniform Light {
    int pass;
    int n;         // the copy's pixels per PS1 pixel
    int taps;      // prepare's samples per PS1 pixel, each way (at most n)
    int flags;     // DEBUG: the parts as colours instead of the lit picture; ALL: every part is read, at strength 0 too
    ivec2 origin;  // the frame's first pixel in `color`
    ivec2 size;    // the frame, in the copy's pixels (the depth image's used size)
    ivec2 work;    // the layers' used size (the frame they were made from, PS1 pixels)
    ivec2 layer;   // this frame's first PS1 pixel in the layers
    vec4 view;     // xyz: the room's up in view space; w: the projection distance
    vec4 lens;     // xy: the projection centre in the frame, PS1 pixels; z: the focus depth
    vec4 strength; // top light, shade, bounce, glow
} pc;

const uint DEPTH_SHARP = 0u;
const uint DEPTH_FAR = 0xFFFFFFFFu;
const uint DEPTH_FIGURE = 0x40000000u;
const int DEBUG = 1, ALL = 2;

// A depth code fits a 16-bit float: the view depth for scenery, its negative
// for a figure, 0 where there is none (nothing drawn, or a kept picture).
const float DEPTH_LIMIT = 60000.0;

// The distant backdrop: full effect up to a relative depth of 0.30 behind the
// focus (1 - focus / z, the depth of field's measure), none from 0.45.
const float FADE_FROM = 0.30, FADE_TO = 0.45;
// Glow: the 8-bit values where a source starts and is whole, the spreads in
// PS1 pixels and their shares.
const float GLOW_FROM = 0.74, GLOW_TO = 1.0, GLOW_GAIN = 0.9;
const vec3 GLOW_SHARE = vec3(0.45, 0.35, 0.20);
// The spreads are Gaussians of 1.2, 3.5 and 8 PS1 pixels. The two wide ones
// are made on the quarter grid, where the 4x4 mean before and the filtered
// read after add 4 square pixels of spread of their own: 0.72 and 1.94
// quarter pixels then make 3.5 and 8.
const float GLOW_NARROW = 1.2;
const vec2 GLOW_WIDE = vec2(0.72, 1.94);
// Bounce: a source is light above BOUNCE_RATIO times its surroundings' mean
// (SURROUND_SIGMA PS1 pixels), and above a floor; the reach in PS1 pixels at
// the focus depth.
const float BOUNCE_RATIO = 2.6, BOUNCE_FLOOR = 0.16, SURROUND_SIGMA = 14.0;
const float BOUNCE_REACH = 40.0, BOUNCE_WRAP = 0.3, BOUNCE_GAIN = 0.012, BOUNCE_FIGURE = 0.6;
const int BOUNCE_SCAN = 16; // quarter pixels each way, at most
// Shade: the reach in PS1 pixels at the focus depth, the samples around.
const float SHADE_REACH = 14.0, SHADE_BIAS = 0.05, SHADE_GAIN = 4.4, SHADE_MOST = 0.85;
const int SHADE_DIRS = 8, SHADE_STEPS = 4;
// Top light: how much an up-facing and a down-facing surface change, and how
// quickly a surface counts as facing up or down: 3 times the cosine of its
// angle to the vertical, at most 1 (anything within about 70 degrees of
// facing up is lit fully). That is the response of the pictures agreed for
// this slice (docs/PORT_HD2D.md section 16): the prototype took the field's
// projection matrix, a rotation times 3, as the up direction.
const float TOP_UP = 0.55, TOP_DOWN = 0.9, TOP_RESPONSE = 3.0;

vec3 light(uint word) {
    vec3 c = vec3(float(word & 255u), float((word >> 8) & 255u), float((word >> 16) & 255u)) / 255.0;
    return c * c;
}

float depthCode(uint raw) {
    if (raw == DEPTH_SHARP || raw == DEPTH_FAR) return 0.0;
    float z = min(float(raw & ~DEPTH_FIGURE) / 16.0, DEPTH_LIMIT);
    return (raw & DEPTH_FIGURE) != 0u ? -z : z;
}

float backdropFade(float z) {
    if (z <= 0.0) return 0.0;
    float u = 1.0 - pc.lens.z / z;
    return clamp((FADE_TO - u) / (FADE_TO - FADE_FROM), 0.0, 1.0);
}

// The view-space place of a point of the frame (PS1 pixels) at view depth z:
// x right, y down, z into the picture.
vec3 place(vec2 at, float z) {
    return vec3((at - pc.lens.xy) * z / pc.view.w, z);
}

// The same for a pixel of the copy, from the depth image; z <= 0: no scenery there.
vec3 placeAt(ivec2 l, out float code) {
    code = l.x < 0 || l.y < 0 || l.x >= pc.size.x || l.y >= pc.size.y ? 0.0 : depthCode(imageLoad(depth, l).r);
    return place((vec2(l) + 0.5) / float(pc.n), abs(code));
}

ivec2 inside(ivec2 t) { return clamp(t, ivec2(0), pc.work - 1); }

// The pixel of the copy that stands for PS1 pixel t (its middle), and where
// that is in the frame, in PS1 pixels.
ivec2 middle(ivec2 t) { return min(t * pc.n + pc.n / 2, pc.size - 1); }
vec2 middleAt(ivec2 t) { return (vec2(middle(t)) + 0.5) / float(pc.n); }

// The quarter grid: its used size, the PS1 pixel that stands for quarter
// pixel q, and where a point of the frame (PS1 pixels) falls in a quarter
// image read with filtering (q's value belongs at that PS1 pixel's middle).
ivec2 quarters() { return (pc.work + 3) / 4; }
ivec2 quarterMiddle(ivec2 q) { return min(q * 4 + 2, pc.work - 1); }
vec2 quarterUv(vec2 at, sampler2D image) {
    return clamp((at - 0.5) / 4.0, vec2(0.5), vec2(quarters()) - 0.5) / vec2(textureSize(image, 0));
}

// A value in [0, 1) that differs from pixel to pixel in a fixed pattern
// (interleaved gradient noise): it turns each pixel's ring of samples.
float turn(ivec2 t) {
    return fract(52.9829189 * fract(0.06711056 * float(t.x) + 0.00583715 * float(t.y)));
}

void prepare(ivec2 t) {
    vec3 sum = vec3(0.0), source = vec3(0.0);
    float count = 0.0;
    for (int y = 0; y < pc.taps; y++) for (int x = 0; x < pc.taps; x++) {
        ivec2 l = t * pc.n + (ivec2(x, y) * 2 + 1) * pc.n / (2 * pc.taps);
        if (l.x >= pc.size.x || l.y >= pc.size.y) continue;
        vec3 c = light(imageLoad(color, pc.origin + l).r);
        float code = depthCode(imageLoad(depth, l).r);
        sum += c;
        count += 1.0;
        if (code > 0.0) {
            float peak = max(c.r, max(c.g, c.b));
            float k = clamp((peak - GLOW_FROM * GLOW_FROM) / (GLOW_TO * GLOW_TO - GLOW_FROM * GLOW_FROM), 0.0, 1.0);
            source += c * (k * k * (3.0 - 2.0 * k) * backdropFade(code));
        }
    }
    count = max(count, 1.0);
    sum /= count;
    imageStore(base, t, vec4(sum, dot(sum, vec3(0.2126, 0.7152, 0.0722))));
    imageStore(glow, t, vec4(source / count, 0.0));

    // The surface at the PS1 pixel's centre: the cross product of the steps
    // to its neighbours in the copy, each taken on the side where the depth
    // changes less (an outline then does not bend the normal).
    ivec2 l = middle(t);
    float code, ca, cb;
    vec3 p = placeAt(l, code);
    vec3 normal = vec3(0.0, 0.0, -1.0);
    if (code > 0.0) {
        vec3 step2[2];
        bool have = true;
        for (int axis = 0; axis < 2; axis++) {
            ivec2 d = axis == 0 ? ivec2(1, 0) : ivec2(0, 1);
            vec3 a = placeAt(l + d, ca) - p, b = p - placeAt(l - d, cb);
            bool okA = ca > 0.0, okB = cb > 0.0;
            if (!okA && !okB) have = false;
            step2[axis] = okA && (!okB || abs(a.z) < abs(b.z)) ? a : b;
        }
        if (have) {
            vec3 c = cross(step2[0], step2[1]);
            float len = length(c);
            if (len > 1.0e-9) {
                normal = c / len;
                if (normal.z > 0.0) normal = -normal; // towards the eye
            }
        }
    }
    imageStore(geo, t, vec4(normal, code));
}

// On the quarter grid: the mean of 4x4 PS1 pixels, of the brightness (for the
// surroundings) and of the glow's source.
void quarter(ivec2 q) {
    float sum = 0.0, count = 0.0;
    vec3 source = vec3(0.0);
    for (int y = 0; y < 4; y++) for (int x = 0; x < 4; x++) {
        ivec2 t = q * 4 + ivec2(x, y);
        if (t.x >= pc.work.x || t.y >= pc.work.y) continue;
        sum += imageLoad(base, t).a;
        source += imageLoad(glow, t).rgb;
        count += 1.0;
    }
    count = max(count, 1.0);
    imageStore(quarterA, q, vec4(sum / count));
    imageStore(quarterGlow, q, vec4(source / count, 0.0));
}

// Across: the surroundings' brightness, and the glow's source at its two wide spreads.
void quarterAcross(ivec2 q) {
    ivec2 last = quarters() - 1;
    float sigma = SURROUND_SIGMA / 4.0;
    float sum = 0.0, total = 0.0;
    vec3 wide[2] = vec3[2](vec3(0.0), vec3(0.0));
    vec2 wideTotal = vec2(0.0);
    for (int d = -10; d <= 10; d++) {
        ivec2 s = clamp(q + ivec2(d, 0), ivec2(0), last);
        float g = exp(-float(d * d) / (2.0 * sigma * sigma));
        sum += imageLoad(quarterA, s).r * g;
        total += g;
        if (abs(d) <= 6) {
            vec3 c = imageLoad(quarterGlow, s).rgb;
            vec2 w = exp(-float(d * d) / (2.0 * GLOW_WIDE * GLOW_WIDE));
            if (abs(d) > 3) w.x = 0.0;
            wide[0] += c * w.x; wide[1] += c * w.y;
            wideTotal += w;
        }
    }
    imageStore(quarterB, q, vec4(sum / total));
    imageStore(quarterE, q, vec4(wide[0] / wideTotal.x, 0.0));
    imageStore(quarterPool, q, vec4(wide[1] / wideTotal.y, 0.0));
}

// Down: the same, and the two wide spreads by their shares into one image.
void quarterDown(ivec2 q) {
    ivec2 last = quarters() - 1;
    float sigma = SURROUND_SIGMA / 4.0;
    float sum = 0.0, total = 0.0;
    vec3 wide[2] = vec3[2](vec3(0.0), vec3(0.0));
    vec2 wideTotal = vec2(0.0);
    for (int d = -10; d <= 10; d++) {
        ivec2 s = clamp(q + ivec2(0, d), ivec2(0), last);
        float g = exp(-float(d * d) / (2.0 * sigma * sigma));
        sum += imageLoad(quarterB, s).r * g;
        total += g;
        if (abs(d) <= 6) {
            vec2 w = exp(-float(d * d) / (2.0 * GLOW_WIDE * GLOW_WIDE));
            if (abs(d) <= 3) wide[0] += imageLoad(quarterE, s).rgb * w.x; else w.x = 0.0;
            wide[1] += imageLoad(quarterPool, s).rgb * w.y;
            wideTotal += w;
        }
    }
    imageStore(quarterA, q, vec4(sum / total));
    imageStore(quarterWide, q, vec4(wide[0] / wideTotal.x * GLOW_SHARE.y + wide[1] / wideTotal.y * GLOW_SHARE.z, 0.0));
}

// What stands out as bright: scenery only, and not the distant backdrop.
void sources(ivec2 t) {
    vec4 b = imageLoad(base, t);
    float code = imageLoad(geo, t).a;
    vec3 e = vec3(0.0);
    if (code > 0.0) {
        float mean = textureLod(surround, quarterUv(vec2(t) + 0.5, surround), 0.0).r;
        float threshold = max(BOUNCE_RATIO * mean, BOUNCE_FLOOR);
        float peak = max(b.r, max(b.g, b.b));
        e = b.rgb * (clamp((peak - threshold) / threshold, 0.0, 1.0) * backdropFade(code));
    }
    imageStore(tempA, t, vec4(e, max(code, 0.0)));
}

// The normals softened along the surface (three PS1 pixels each way, only
// across scenery of nearly the same depth), so low-poly rock reads as rock.
void softNormals(ivec2 t, ivec2 axis, bool second) {
    vec4 own = second ? imageLoad(tempB, t) : imageLoad(geo, t);
    if (own.a <= 0.0) {
        if (second) imageStore(tempC, t, own);
        else imageStore(tempB, t, own);
        return;
    }
    vec3 sum = vec3(0.0);
    for (int d = -3; d <= 3; d++) {
        ivec2 s = t + axis * d;
        if (s.x < 0 || s.y < 0 || s.x >= pc.work.x || s.y >= pc.work.y) continue;
        vec4 v = second ? imageLoad(tempB, s) : imageLoad(geo, s);
        if (v.a <= 0.0) continue;
        sum += v.xyz * (exp(-float(d * d) / 4.5) * exp(-abs(v.a - own.a) / (0.012 * own.a)));
    }
    float len = length(sum);
    vec4 result = vec4(len > 1.0e-6 ? sum / len : own.xyz, own.a);
    if (second) imageStore(tempC, t, result);
    else imageStore(tempB, t, result);
}

// Top light from the softened normal; shade from the depth image around the
// PS1 pixel's centre, sampled in the copy so a near thing's small reach
// still finds its samples.
void topAndShade(ivec2 t) {
    vec4 soft = imageLoad(tempC, t);
    vec4 raw = imageLoad(geo, t);
    float code = raw.a;
    if (code <= 0.0) {
        imageStore(terms, t, vec4(0.0, 0.0, code, 0.0));
        return;
    }
    float fade = backdropFade(code);
    float top = clamp(TOP_RESPONSE * dot(soft.xyz, pc.view.xyz), -1.0, 1.0) * fade;
    float occlusion = 0.0;
    if (fade > 0.0 && (pc.strength.y > 0.0 || (pc.flags & (DEBUG | ALL)) != 0)) {
        ivec2 l = middle(t);
        vec3 p = place(middleAt(t), code);
        float reach = SHADE_REACH * pc.lens.z / pc.view.w;                              // view units
        float pixels = clamp(reach * pc.view.w / code, 1.0, 40.0) * float(pc.n);        // the copy's pixels, here
        float noise = turn(t);
        for (int d = 0; d < SHADE_DIRS; d++) {
            float angle = (float(d) + noise) * (6.2831853 / float(SHADE_DIRS));
            vec2 dir = vec2(cos(angle), sin(angle));
            for (int k = 0; k < SHADE_STEPS; k++) {
                float along = (float(k) + 0.5 + 0.5 * fract(noise * 7.0 + float(d) * 0.37)) / float(SHADE_STEPS);
                float sc;
                vec3 v = placeAt(l + ivec2(dir * pixels * along), sc) - p;
                if (sc <= 0.0) continue; // figures and empty pixels cast none
                float d2 = dot(v, v);
                float dist = sqrt(max(d2, 1.0e-6));
                occlusion += max(dot(raw.xyz, v) / dist - SHADE_BIAS, 0.0) * max(1.0 - d2 / (reach * reach), 0.0);
            }
        }
        occlusion *= fade / float(SHADE_DIRS * SHADE_STEPS);
    }
    imageStore(terms, t, vec4(top, occlusion, code, fade));
}

// The shade smoothed along surfaces: across scenery of nearly the same depth
// that faces the same way.
void shadeBlur(ivec2 t, ivec2 axis, bool second) {
    vec4 own = second ? imageLoad(tempB, t) : imageLoad(terms, t);
    if (own.b > 0.0) {
        vec3 normal = imageLoad(geo, t).xyz;
        float sum = 0.0, total = 0.0;
        for (int d = -2; d <= 2; d++) {
            ivec2 s = t + axis * d;
            if (s.x < 0 || s.y < 0 || s.x >= pc.work.x || s.y >= pc.work.y) continue;
            vec4 v = second ? imageLoad(tempB, s) : imageLoad(terms, s);
            if (v.b <= 0.0) continue;
            float facing = max(dot(imageLoad(geo, s).xyz, normal), 0.0);
            facing *= facing; facing *= facing; facing *= facing;
            float w = exp(-float(d * d) / 2.0) * exp(-abs(v.b - own.b) / (0.02 * own.b)) * facing;
            sum += v.g * w;
            total += w;
        }
        if (total > 0.0) own.g = sum / total;
    }
    if (second) imageStore(terms, t, own);
    else imageStore(tempB, t, own);
}

// The sources of 4x4 PS1 pixels as one: their light summed, at the depth
// their light is at on average.
void quarterSources(ivec2 q) {
    vec3 sum = vec3(0.0);
    float weight = 0.0, depthSum = 0.0;
    for (int y = 0; y < 4; y++) for (int x = 0; x < 4; x++) {
        ivec2 t = q * 4 + ivec2(x, y);
        if (t.x >= pc.work.x || t.y >= pc.work.y) continue;
        vec4 e = imageLoad(tempA, t);
        float w = e.r + e.g + e.b;
        sum += e.rgb;
        weight += w;
        depthSum += e.a * w;
    }
    imageStore(quarterE, q, vec4(sum, weight > 0.0 ? depthSum / weight : 0.0));
}

// The sources within reach of each quarter pixel, by distance in the scene
// and by how its surface faces them: every one of them, so nothing flickers.
// A figure has no surface: it takes a fixed share.
void gather(ivec2 q) {
    ivec2 t = quarterMiddle(q);
    vec4 g = imageLoad(geo, t);
    float z = abs(g.a);
    vec3 sum = vec3(0.0);
    if (z > 0.0) {
        vec3 p = place(middleAt(t), z);
        float reach = BOUNCE_REACH * pc.lens.z / pc.view.w;       // view units
        float pixels = clamp(reach * pc.view.w / z, 2.0, 96.0);   // PS1 pixels, here
        float span = pixels / 4.0;                                // quarter pixels
        int scan = min(int(ceil(span)), BOUNCE_SCAN);
        float near = 8.0 * z / pc.view.w;                         // two quarter pixels here, in view units
        ivec2 last = quarters() - 1;
        for (int y = -scan; y <= scan; y++) for (int x = -scan; x <= scan; x++) {
            if (float(x * x + y * y) > span * span) continue;
            ivec2 s = q + ivec2(x, y);
            if (s.x < 0 || s.y < 0 || s.x > last.x || s.y > last.y) continue;
            vec4 e = imageLoad(quarterE, s);
            if (e.a <= 0.0) continue;
            vec3 v = place(middleAt(quarterMiddle(s)), e.a) - p;
            float d2 = dot(v, v);
            float dist = sqrt(max(d2, 1.0e-6));
            float facing = BOUNCE_FIGURE;
            if (g.a > 0.0) {
                // Closer than two quarter pixels the direction to a source means
                // little (it may be this very spot): the fixed share there, the
                // surface's facing beyond.
                float lambert = clamp((dot(g.xyz, v) / dist + BOUNCE_WRAP) / (1.0 + BOUNCE_WRAP), 0.0, 1.0);
                facing = mix(BOUNCE_FIGURE, lambert, clamp(dist / near, 0.0, 1.0));
            }
            float window = max(1.0 - d2 / (reach * reach), 0.0);
            sum += e.rgb * (window * window * facing);
        }
        // The mean over the disc times its area in PS1 pixels, over pi: the
        // sum of the sources in it over pi.
        sum /= 3.14159265;
    }
    imageStore(quarterPool, q, vec4(sum, z));
}

// The glow's narrow spread across, then down with the wide spreads added.
void glowAcross(ivec2 t) {
    vec3 sum = vec3(0.0);
    float total = 0.0;
    for (int d = -4; d <= 4; d++) {
        float g = exp(-float(d * d) / (2.0 * GLOW_NARROW * GLOW_NARROW));
        sum += imageLoad(glow, inside(t + ivec2(d, 0))).rgb * g;
        total += g;
    }
    imageStore(tempA, t, vec4(sum / total, 0.0));
}

void glowDown(ivec2 t) {
    vec3 sum = vec3(0.0);
    float total = 0.0;
    for (int d = -4; d <= 4; d++) {
        float g = exp(-float(d * d) / (2.0 * GLOW_NARROW * GLOW_NARROW));
        sum += imageLoad(tempA, inside(t + ivec2(0, d))).rgb * g;
        total += g;
    }
    vec3 wide = textureLod(wideLayer, quarterUv(vec2(t) + 0.5, wideLayer), 0.0).rgb;
    imageStore(glow, t, vec4((sum / total * GLOW_SHARE.x + wide) * GLOW_GAIN, 0.0));
}

// Brighter by a factor with a shoulder: black stays black, white stays white.
vec3 brighten(vec3 c, vec3 factor) {
    return c * factor / (1.0 + (factor - 1.0) * clamp(c, 0.0, 1.0));
}

void composite(ivec2 l) {
    ivec2 p = pc.origin + l;
    uint word = imageLoad(color, p).r;
    uint raw = imageLoad(depth, l).r;
    float code = depthCode(raw);
    vec3 c = light(word);
    // This pixel's place on the PS1 grid, kept inside the part of the layers
    // this frame made (the images may be larger).
    vec2 at = (vec2(l) + 0.5) / float(pc.n) + vec2(pc.layer);
    vec2 uv = clamp(at, vec2(0.5), vec2(pc.work) - 0.5) / vec2(textureSize(glowLayer, 0));

    bool all = (pc.flags & (DEBUG | ALL)) != 0;
    bool surface = code > 0.0 && (all || pc.strength.x > 0.0 || pc.strength.y > 0.0);
    float top = 0.0, shade = 0.0;
    vec4 smooth4 = surface ? textureLod(termsLayer, uv, 0.0) : vec4(0.0);
    if (surface && abs(smooth4.b - code) <= 0.004 * code) {
        // Inside a surface: the four PS1 pixels around are on it too.
        top = smooth4.r;
        shade = smooth4.g;
    } else if (surface) {
        // At an outline: the four one by one, by closeness on the screen and in depth.
        vec2 f = at - 0.5;
        ivec2 t0 = ivec2(floor(f));
        vec2 w = f - vec2(t0);
        float total = 0.0;
        for (int k = 0; k < 4; k++) {
            ivec2 o = ivec2(k & 1, k >> 1);
            vec4 v = imageLoad(terms, inside(t0 + o));
            if (v.b <= 0.0) continue;
            float weight = (o.x == 1 ? w.x : 1.0 - w.x) * (o.y == 1 ? w.y : 1.0 - w.y);
            weight = (weight + 0.02) * exp(-abs(v.b - code) / (0.02 * code));
            top += v.r * weight;
            shade += v.g * weight;
            total += weight;
        }
        if (total > 1.0e-5) { top /= total; shade /= total; } else { top = 0.0; shade = 0.0; }
    }
    vec3 pool = vec3(0.0);
    if (code != 0.0 && (all || pc.strength.z > 0.0)) {
        float z = abs(code);
        vec4 around = textureLod(poolLayer, quarterUv(at, poolLayer), 0.0);
        if (abs(around.a - z) <= 0.01 * z) {
            pool = around.rgb;
        } else {
            // At an outline: the four quarter pixels one by one.
            vec2 f = (at - 0.5) / 4.0 - 0.5;
            ivec2 q0 = ivec2(floor(f));
            vec2 w = f - vec2(q0);
            float total = 0.0;
            for (int k = 0; k < 4; k++) {
                ivec2 o = ivec2(k & 1, k >> 1);
                vec4 v = imageLoad(quarterPool, clamp(q0 + o, ivec2(0), quarters() - 1));
                if (v.a <= 0.0) continue;
                float weight = (o.x == 1 ? w.x : 1.0 - w.x) * (o.y == 1 ? w.y : 1.0 - w.y);
                weight = (weight + 0.02) * exp(-abs(v.a - z) / (0.05 * z));
                pool += v.rgb * weight;
                total += weight;
            }
            pool = total > 1.0e-5 ? pool / total : vec3(0.0);
        }
        pool *= BOUNCE_GAIN;
    }
    vec3 halo = all || pc.strength.w > 0.0 ? textureLod(glowLayer, uv, 0.0).rgb : vec3(0.0);

    if ((pc.flags & DEBUG) != 0) {
        // Red: shade; green: top light around a middle; blue: glow and bounce.
        vec3 shown = vec3(clamp(shade * SHADE_GAIN, 0.0, 1.0), 0.5 + 0.5 * top,
                          clamp(dot(halo + pool, vec3(0.3333)), 0.0, 1.0));
        uvec3 o = uvec3(clamp(shown, 0.0, 1.0) * 255.0 + 0.5);
        imageStore(color, p, uvec4((word & 0xFF000000u) | o.r | o.g << 8 | o.b << 16));
        return;
    }

    if (code > 0.0 && pc.strength.x > 0.0) {
        float f = 1.0 + pc.strength.x * (top > 0.0 ? TOP_UP : TOP_DOWN) * top;
        f *= f;
        c = f > 1.0 ? brighten(c, vec3(f)) : c * f;
    }
    if (pc.strength.z > 0.0) c = brighten(c, 1.0 + pc.strength.z * pool);
    if (code > 0.0 && pc.strength.y > 0.0) {
        float s = 1.0 - clamp(pc.strength.y * SHADE_GAIN * shade, 0.0, SHADE_MOST);
        c *= s * s;
    }
    if (pc.strength.w > 0.0) c += pc.strength.w * halo * (1.0 - clamp(c, 0.0, 1.0)); // never past white
    uvec3 o = uvec3(clamp(sqrt(max(c, 0.0)), 0.0, 1.0) * 255.0 + 0.5);
    uint packed = o.r | o.g << 8 | o.b << 16;
    // A pixel nothing changed is not written: it stays bit for bit what was drawn.
    if (packed != (word & 0xFFFFFFu)) imageStore(color, p, uvec4((word & 0xFF000000u) | packed));
}

void main() {
    ivec2 t = ivec2(gl_GlobalInvocationID.xy);
    if (pc.pass == 14) {
        if (t.x < pc.size.x && t.y < pc.size.y) composite(t);
        return;
    }
    if ((pc.pass >= 1 && pc.pass <= 3) || pc.pass == 10 || pc.pass == 11) {
        ivec2 q = quarters();
        if (t.x >= q.x || t.y >= q.y) return;
        switch (pc.pass) {
        case 1: quarter(t); break;
        case 2: quarterAcross(t); break;
        case 3: quarterDown(t); break;
        case 10: quarterSources(t); break;
        default: gather(t); break;
        }
        return;
    }
    if (t.x >= pc.work.x || t.y >= pc.work.y) return;
    switch (pc.pass) {
    case 0: prepare(t); break;
    case 4: sources(t); break;
    case 5: softNormals(t, ivec2(1, 0), false); break;
    case 6: softNormals(t, ivec2(0, 1), true); break;
    case 7: topAndShade(t); break;
    case 8: shadeBlur(t, ivec2(1, 0), false); break;
    case 9: shadeBlur(t, ivec2(0, 1), true); break;
    case 12: glowAcross(t); break;
    default: glowDown(t); break;
    }
}
