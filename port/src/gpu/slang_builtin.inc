/*
 * The shader presets built into the port (slangp.c reads "builtin:<name>"),
 * our own, in the RetroArch slang format: movie-smooth.slangp, the movies
 * (xg-htn.35.10) with the MDEC's block edges softened and a Catmull-Rom
 * upscale to the window with a light sharpening. Kept as text: they are
 * compiled like any preset (glslang).
 */

static const struct {
    const char* name;
    const char* text;
} slangBuiltins[] = {
    {"movie-smooth.slangp",
     "# The movies, smoothed and upscaled (the port's own, xg-htn.35.10): the\n"
     "# MDEC's 8x8 block edges softened across and down, then a Catmull-Rom\n"
     "# upscale to the window with a light sharpening.\n"
     "shaders = 3\n"
     "shader0 = movie-deblock-h.slang\n"
     "filter_linear0 = false\n"
     "scale_type0 = source\n"
     "scale0 = 1.0\n"
     "shader1 = movie-deblock-v.slang\n"
     "filter_linear1 = false\n"
     "scale_type1 = source\n"
     "scale1 = 1.0\n"
     "shader2 = movie-upscale.slang\n"
     "filter_linear2 = false\n"},
    {"movie-deblock.inc",
     "layout(push_constant) uniform Push {\n"
     "    vec4 SourceSize;\n"
     "    vec4 OriginalSize;\n"
     "    float DEBLOCK;\n"
     "} params;\n"
     "#pragma parameter DEBLOCK \"Block edges softened\" 1.0 0.0 2.0 0.1\n"
     "layout(std140, set = 0, binding = 0) uniform UBO {\n"
     "    mat4 MVP;\n"
     "} global;\n"
     "#pragma stage vertex\n"
     "layout(location = 0) in vec4 Position;\n"
     "layout(location = 1) in vec2 TexCoord;\n"
     "layout(location = 0) out vec2 vTexCoord;\n"
     "void main() {\n"
     "    gl_Position = global.MVP * Position;\n"
     "    vTexCoord = TexCoord;\n"
     "}\n"
     "#pragma stage fragment\n"
     "layout(location = 0) in vec2 vTexCoord;\n"
     "layout(location = 0) out vec4 FragColor;\n"
     "layout(set = 0, binding = 2) uniform sampler2D Source;\n"
     "vec3 at(ivec2 p) {\n"
     "    return texelFetch(Source, clamp(p, ivec2(0), ivec2(params.SourceSize.xy) - 1), 0).rgb;\n"
     "}\n"
     "float luma(vec3 c) {\n"
     "    return dot(c, vec3(0.299, 0.587, 0.114));\n"
     "}\n"
     "// A block edge between b and c (a before b, d after c) is softened into a\n"
     "// ramp when the step there is small and both sides are smooth: the MDEC's\n"
     "// blocking, not a real edge. Returns this pixel's (role 0..3: a, b, c, d) new value.\n"
     "vec3 soften(vec3 a, vec3 b, vec3 c, vec3 d, int role) {\n"
     "    float limit = 0.10 * params.DEBLOCK, quiet = 0.5 * limit;\n"
     "    float step = abs(luma(c) - luma(b));\n"
     "    vec3 v = role == 0 ? a : role == 1 ? b : role == 2 ? c : d;\n"
     "    if (params.DEBLOCK <= 0.0 || step >= limit || abs(luma(a) - luma(b)) >= quiet || abs(luma(c) - luma(d)) >= quiet) {\n"
     "        return v;\n"
     "    }\n"
     "    vec3 s = c - b;\n"
     "    return role == 0 ? a + s * 0.125 : role == 1 ? b + s * 0.375 : role == 2 ? c - s * 0.375 : d - s * 0.125;\n"
     "}\n"
     "void main() {\n"
     "    ivec2 p = ivec2(floor(vTexCoord * params.SourceSize.xy));\n"
     "    vec3 v = at(p);\n"
     "    // only the movies' own frames (a pack's pictures are not blocky)\n"
     "    if (params.OriginalSize.x <= 400.0) {\n"
     "        int i = DIRECTION == 0 ? p.x : p.y;\n"
     "        int k = i & 7;\n"
     "        ivec2 dir = DIRECTION == 0 ? ivec2(1, 0) : ivec2(0, 1);\n"
     "        if (k >= 6) {\n"
     "            ivec2 b = p + dir * (7 - k);\n"
     "            v = soften(at(b - dir), at(b), at(b + dir), at(b + 2 * dir), k - 6);\n"
     "        } else if (k <= 1 && i >= 8) {\n"
     "            ivec2 c = p - dir * k;\n"
     "            v = soften(at(c - 2 * dir), at(c - dir), at(c), at(c + dir), k + 2);\n"
     "        }\n"
     "    }\n"
     "    FragColor = vec4(v, 1.0);\n"
     "}\n"},
    {"movie-deblock-h.slang",
     "#version 450\n"
     "// The movies' block edges across (movie-smooth.slangp).\n"
     "#define DIRECTION 0\n"
     "#include \"movie-deblock.inc\"\n"},
    {"movie-deblock-v.slang",
     "#version 450\n"
     "// The movies' block edges down (movie-smooth.slangp).\n"
     "#define DIRECTION 1\n"
     "#include \"movie-deblock.inc\"\n"},
    {"movie-upscale.slang",
     "#version 450\n"
     "// Catmull-Rom to the window, then a light sharpening against a bilinear\n"
     "// sample (movie-smooth.slangp).\n"
     "layout(push_constant) uniform Push {\n"
     "    vec4 SourceSize;\n"
     "    float SHARPEN;\n"
     "} params;\n"
     "#pragma parameter SHARPEN \"Sharpening\" 0.3 0.0 1.0 0.05\n"
     "layout(std140, set = 0, binding = 0) uniform UBO {\n"
     "    mat4 MVP;\n"
     "} global;\n"
     "#pragma stage vertex\n"
     "layout(location = 0) in vec4 Position;\n"
     "layout(location = 1) in vec2 TexCoord;\n"
     "layout(location = 0) out vec2 vTexCoord;\n"
     "void main() {\n"
     "    gl_Position = global.MVP * Position;\n"
     "    vTexCoord = TexCoord;\n"
     "}\n"
     "#pragma stage fragment\n"
     "layout(location = 0) in vec2 vTexCoord;\n"
     "layout(location = 0) out vec4 FragColor;\n"
     "layout(set = 0, binding = 2) uniform sampler2D Source;\n"
     "vec3 at(ivec2 p) {\n"
     "    return texelFetch(Source, clamp(p, ivec2(0), ivec2(params.SourceSize.xy) - 1), 0).rgb;\n"
     "}\n"
     "vec4 weights(float t) {\n"
     "    // Catmull-Rom (B = 0, C = 1/2)\n"
     "    float t2 = t * t, t3 = t2 * t;\n"
     "    return vec4(-0.5 * t3 + t2 - 0.5 * t, 1.5 * t3 - 2.5 * t2 + 1.0, -1.5 * t3 + 2.0 * t2 + 0.5 * t, 0.5 * t3 - 0.5 * t2);\n"
     "}\n"
     "void main() {\n"
     "    vec2 s = vTexCoord * params.SourceSize.xy - 0.5;\n"
     "    ivec2 base = ivec2(floor(s));\n"
     "    vec2 f = s - vec2(base);\n"
     "    vec4 wx = weights(f.x), wy = weights(f.y);\n"
     "    vec3 cubic = vec3(0.0);\n"
     "    for (int j = 0; j < 4; j++) {\n"
     "        vec3 row = vec3(0.0);\n"
     "        for (int i = 0; i < 4; i++) {\n"
     "            row += at(base + ivec2(i - 1, j - 1)) * wx[i];\n"
     "        }\n"
     "        cubic += row * wy[j];\n"
     "    }\n"
     "    vec3 lin = mix(mix(at(base), at(base + ivec2(1, 0)), f.x), mix(at(base + ivec2(0, 1)), at(base + ivec2(1, 1)), f.x), f.y);\n"
     "    FragColor = vec4(clamp(cubic + params.SHARPEN * (cubic - lin), 0.0, 1.0), 1.0);\n"
     "}\n"},
};
