<?xml version="1.0" encoding="utf-8"?>
<!-- The menu window over black: a grey interior, a fine silver edge
     and the warm glow visible outside the frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="5dp" />
            <solid android:color="#44392E20" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape>
            <corners android:radius="3dp" />
            <solid android:color="#AD766A54" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape>
            <corners android:radius="2dp" />
            <stroke android:width="1dp" android:color="#EEEAFD" />
            <solid android:color="#292351" />
        </shape>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape><solid android:color="#343434" /></shape>
    </item>
</layer-list>
