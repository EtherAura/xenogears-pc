<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon (xg-bze9): the project's mark, the red menu cursor on black (the
     website's favicon and the channel's picture: tools/publish/channel_art.py), drawn as
     vectors. Adaptive (the launcher's own mask) with a monochrome layer for the themed icons
     of Android 13 and later. The app needs Android 13, so no bitmap fallbacks. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
