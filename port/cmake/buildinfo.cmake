# The settings menu's About section (port/src/ui): the build line, the port's
# own licence (port/COPYING, GPL-3.0-or-later) and the licences of the
# libraries in the executable (SDL3, Dear ImGui, the jukebox font). Run at each
# build by the ui_buildinfo target (port/CMakeLists.txt). OUT is rewritten
# only when its text changes, so an unchanged tree recompiles nothing.
#
#   cmake -DOUT=<header> -DROOT=<repository> -DVERSION=US|JP -DTYPE=<build type>
#         -DIMGUI_LICENSE=<file> -DSDL_LICENSE=<file or empty> [-DGLSLANG_LICENSE=<file>] [-DDAV1D_LICENSE=<file>]
#         [-DLIBCXX_LICENSE=<file>] -P buildinfo.cmake

set(rev "unknown")
execute_process(COMMAND git -C "${ROOT}" rev-parse --short HEAD
                OUTPUT_VARIABLE out RESULT_VARIABLE status OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(status EQUAL 0 AND out)
    set(rev "${out}")
    execute_process(COMMAND git -C "${ROOT}" status --porcelain --untracked-files=no
                    OUTPUT_VARIABLE dirty OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(dirty)
        set(rev "${rev}+changes")
    endif()
endif()
string(TIMESTAMP day "%Y-%m-%d")
if(NOT TYPE)
    set(TYPE "default")
endif()
set(text "/* Generated by port/cmake/buildinfo.cmake. */\n#define XG_BUILD_REV \"${rev}\"\n#define XG_BUILD_DAY \"${day}\"\n#define XG_BUILD_TYPE \"${TYPE}\"\n#define XG_BUILD_VERSION \"${VERSION}\"\n")

# The licences, as C++ raw strings. SDL3's file where its package has one
# (the MinGW build's), else the zlib licence SDL3 is under.
file(READ "${IMGUI_LICENSE}" imgui)
if(SDL_LICENSE AND EXISTS "${SDL_LICENSE}")
    file(READ "${SDL_LICENSE}" sdl)
else()
    set(sdl "Copyright (C) 1997-2026 Sam Lantinga <slouken@libsdl.org>

This software is provided 'as-is', without any express or implied
warranty.  In no event will the authors be held liable for any damages
arising from the use of this software.

Permission is granted to anyone to use this software for any purpose,
including commercial applications, and to alter it and redistribute it
freely, subject to the following restrictions:

1. The origin of this software must not be misrepresented; you must not
   claim that you wrote the original software. If you use this software
   in a product, an acknowledgment in the product documentation would be
   appreciated but is not required.
2. Altered source versions must be plainly marked as such, and must not be
   misrepresented as being the original software.
3. This notice may not be removed or altered from any source distribution.
")
endif()
string(APPEND text "static const char xgLicenseImgui[] = R\"xglicence(${imgui})xglicence\";\n")
string(APPEND text "static const char xgLicenseSdl[] = R\"xglicence(${sdl})xglicence\";\n")
# dav1d, when the build links it (AV1 movie videos).
if(DAV1D_LICENSE AND EXISTS "${DAV1D_LICENSE}")
    file(READ "${DAV1D_LICENSE}" dav1d)
    string(APPEND text "#define XG_LICENSE_DAV1D 1\nstatic const char xgLicenseDav1d[] = R\"xglicence(${dav1d})xglicence\";\n")
endif()
# Khronos glslang, when the build links it (shader presets).
if(GLSLANG_LICENSE AND EXISTS "${GLSLANG_LICENSE}")
    file(READ "${GLSLANG_LICENSE}" glslang)
    string(APPEND text "#define XG_LICENSE_GLSLANG 1\nstatic const char xgLicenseGlslang[] = R\"xglicence(${glslang})xglicence\";\n")
endif()
# LLVM libc++ and libunwind, in an Android build (the NDK's runtime: libc++_shared.so in the APK).
if(LIBCXX_LICENSE AND EXISTS "${LIBCXX_LICENSE}")
    file(READ "${LIBCXX_LICENSE}" libcxx)
    string(APPEND text "#define XG_LICENSE_LIBCXX 1\nstatic const char xgLicenseLibcxx[] = R\"xglicence(${libcxx})xglicence\";\n")
endif()
file(READ "${ROOT}/port/third_party/jukebox-font/LICENSE.txt" jukebox_font)
file(READ "${ROOT}/port/COPYING" port_licence)
string(APPEND text "static const char xgLicensePort[] = R\"xglicence(${port_licence})xglicence\";\n")
string(APPEND text "static const char xgLicenseJukeboxFont[] = R\"xglicence(${jukebox_font})xglicence\";\n")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
